# =============================================================================
# Stage 5d-alpha: Held-Out Test Evaluation (CRITICAL for Nature Methods)
# =============================================================================
# Computes REAL evaluation metrics on held-out test data:
# - Wasserstein distance (transition quality)
# - MMD (distribution matching)
# - Stage classification accuracy/F1
# - Context sensitivity (niche contribution)
#
# This is separate from validation loss tracked during training!

rule heldout_evaluation:
    """Run held-out test evaluation on a single trained model."""
    input:
        checkpoint = f"{TRAINING}/fold{{fold}}_seed{{seed}}/checkpoints/best_checkpoint.pt",
        cells = f"{CANONICAL}/cells.parquet",
        neighborhoods = f"{CANONICAL}/neighborhoods.parquet",
        splits = f"{CANONICAL}/split_manifest.json"
    output:
        results = f"{TRAINING}/fold{{fold}}_seed{{seed}}/evaluation/heldout_evaluation.json"
    wildcard_constraints:
        fold = "[0-4]",
        seed = "[0-9]+"
    params:
        canonical_dir = CANONICAL
    threads: 4
    resources:
        mem_mb = 64000,
        runtime = 60,
        slurm_partition = "gpu",
        gpu = 1
    log:
        f"{RUNS}/logs/evaluation/heldout_fold{{fold}}_seed{{seed}}.log"
    shell:
        """
        python workflow/scripts/run_heldout_evaluation.py \
            --checkpoint {input.checkpoint} \
            --data_dir {params.canonical_dir} \
            --output_dir {TRAINING}/fold{wildcards.fold}_seed{wildcards.seed}/evaluation \
            --fold {wildcards.fold} \
            2>&1 | tee {log}
        """


rule aggregate_heldout_evaluation:
    """Aggregate held-out evaluation across all folds and seeds."""
    input:
        evaluations = expand(
            f"{TRAINING}/fold{{fold}}_seed{{seed}}/evaluation/heldout_evaluation.json",
            fold=FOLDS, seed=SEEDS
        )
    output:
        summary = f"{TRAINING}/evaluation/heldout_summary.json"
    threads: 2
    resources:
        mem_mb = 8000,
        runtime = 15
    log:
        f"{RUNS}/logs/evaluation/aggregate_heldout.log"
    run:
        import json
        from pathlib import Path
        import numpy as np

        results = []
        for f in input.evaluations:
            with open(f) as fp:
                results.append(json.load(fp))

        metrics = {}
        for key in ['wasserstein', 'mmd', 'mse', 'stage_accuracy', 'auroc']:
            vals = [r['transition_metrics'].get(key) for r in results if r.get('transition_metrics', {}).get(key) is not None]
            if vals:
                metrics[key] = {'mean': float(np.mean(vals)), 'std': float(np.std(vals)), 'n': len(vals)}

        context_deltas = [r.get('context_sensitivity', {}).get('mean_context_delta') for r in results if r.get('context_sensitivity')]
        if context_deltas:
            metrics['context_sensitivity'] = {'mean': float(np.mean(context_deltas)), 'std': float(np.std(context_deltas))}

        summary = {'n_runs': len(results), 'metrics': metrics}
        Path(output.summary).parent.mkdir(parents=True, exist_ok=True)
        with open(output.summary, 'w') as f:
            json.dump(summary, f, indent=2)


