    shell:
        """
        mkdir -p {FIGURES}/spatial_backends

        python scripts/viz/publication_spatial_backends.py \
            --spatial_dir {SPATIAL} \
            --output_dir {FIGURES}/spatial_backends \
            2>&1 | tee {log}
        """


rule showcase_figures:
    """Generate dramatic showcase figures for posters and publications.

    Includes:
    - 3D progression visualization
    - Density contours
    - PAGA-style connectivity graph
    - Pseudotime ridge plot
    - Cell type alluvial diagram
    - Hero summary figure
    """
    input:
        cells = f"{CANONICAL}/cells.parquet",
        neighborhoods = f"{CANONICAL}/neighborhoods.parquet"
    output:
        hero = f"{FIGURES}/showcase/fig_hero_summary.png",
        hero_pdf = f"{FIGURES}/showcase/fig_hero_summary.pdf",
        progression_3d = f"{FIGURES}/showcase/fig_3d_progression.png",
        density = f"{FIGURES}/showcase/fig_density_contours.png",
        paga = f"{FIGURES}/showcase/fig_paga_style.png",
        ridge = f"{FIGURES}/showcase/fig_pseudotime_ridge.png",
        alluvial = f"{FIGURES}/showcase/fig_celltype_alluvial.png",
        manifest = f"{FIGURES}/showcase/manifest.json"
    threads: 4
    resources:
        mem_mb = 64000,
        runtime = 90
    log:
        f"{RUNS}/logs/showcase_figures.log"
    shell:
        """
        mkdir -p {FIGURES}/showcase

        python scripts/viz/publication_showcase_figures.py \
            --data_dir {CANONICAL} \
            --output_dir {FIGURES}/showcase \
            2>&1 | tee {log}
        """


# =============================================================================
# Utility Rules
# =============================================================================

rule clean:
    params:
        runs_dir = RUNS,
        ref_geom_dir = REF_GEOM,
        canonical_dir = CANONICAL
    shell:
        """
        echo "This would remove all outputs. Use with caution!"
        echo "Run: rm -rf {params.runs_dir}/* {params.ref_geom_dir}/* {params.canonical_dir}/*"
        """


rule dag:
    output:
        "workflow/dag.pdf"
    shell:
        "snakemake --dag | dot -Tpdf > {output}"


# =============================================================================
# Execution DAG (Snakemake handles this automatically based on input/output)
# =============================================================================
#
# STAGE 1-2: Reference Mapping (parallel)
#
#   snrna_qc_normalized_with_ensg.h5ad
#              │
#     ┌────────┴────────┐
#     ▼                 ▼
#  hlca_mapping    luca_mapping
#     │                 │
#     ├────────┬────────┤
#     │        ▼        │
#     │  fuse_embeddings│
#     │        │        │
#     ▼        │        ▼
#  add_cell_type_labels ←┘
#              │
#              ▼
#       validate_markers
#              │
#     ┌────────┴────────┐
#     │                 │
#     ▼                 ▼
# clonal_extraction  spatial_backend (8 backends × 2 label sources × 56 samples)
#     │                 │
#     │        ┌────────┴────────┐
#     │        ▼                 ▼
#     │  spatial_aggregate  spatial_unified_figures
#     │        │                 │
#     │        └────────┬────────┘
#     │                 ▼
#     │        spatial_comparison ──→ backend_comparison.json
#     │                 │
#     │                 ▼
#     │        canonical_backend_aggregate
#     │                 │
#     └────────┬────────┘
#              ▼
# STAGE 4: Data Preparation
#
#       data_preparation (merges: fused embedding + canonical spatial + clonal patterns)
#              │
#     ┌────────┴────────┐
#     ▼                 ▼
# validate_splits  semi_synthetic_benchmark
#     │                 │
#     └────────┬────────┘
#              ▼
# STAGE 5: Training & Validation
#
#            hpo (30 Optuna trials)
#              │
#     ┌────────┴────────┬────────────────┐
#     ▼                 ▼                ▼
#  training         training_frozen   baseline
#  (5×3=15)         (5×3=15)          (4×5×3=60)
#     │                 │                │
#     ▼                 │                ▼
# aggregate_cv_results  │         aggregate_baselines
#     │                 │                │
#     ├─────────────────┴────────────────┤
#     │                                  │
#     ▼                                  ▼
# h3_validation                    baseline_comparison.json
#     │
#     ▼
# STAGE 6-7: Ablation & Publication
#
#  ablation (14 configurations)
#     │
#     ▼
# ablation_summary
#     │
#     ├─────────────────────────────────┐
#     ▼                                 ▼
# publication_figures            figure_manifest.json
#
# =============================================================================
# Key Outputs:
#   - clonal_patterns.json: Donor → pattern (1a/1b/2) mapping for H3 validation
#   - cells.parquet: All cells with clonal_pattern + clonal_pattern_idx columns
#   - h3_validation.json: H3.1 (AUC, OR) + H3.2 (p-value, effect size) results
# =============================================================================
#
