            --checkpoint {input.checkpoint} \
            --data_dir {params.canonical_dir} \
            --output_dir {params.h3_dir} \
            2>&1 | tee {log}
        """


# =============================================================================
# Stage 5d-ter: H1.3 Plasticity Validation
# =============================================================================
# Validates H1.3 hypothesis using trained model:
#   H1.3.0: Niche conditioning reduces fate uncertainty (entropy reduction)
#   H1.3.1: KACs/RPII have highest plasticity among epithelial cells
#   H1.3.2: IL1B-high niches commit plastic cells toward tumor

PLASTICITY = f"{RUNS}/biological_validation/plasticity"

rule plasticity_validation:
    input:
        checkpoint = f"{TRAINING}/fold0_seed42/checkpoints/best_checkpoint.pt",
        cells = f"{CANONICAL}/cells.parquet",
        cv_results = f"{TRAINING}/aggregated/cv_results.json",
        # no_niche ablation is optional - checked at runtime
        ablation_summary = f"{ABLATIONS}/ablation_summary.json"  # Ensures ablations complete first
    output:
        results = f"{PLASTICITY}/plasticity_validation.json",
        inference = f"{PLASTICITY}/full_model_inference.parquet"
    params:
        canonical_dir = CANONICAL,
        plasticity_dir = PLASTICITY,
        no_niche_ckpt = f"{ABLATIONS}/no_niche/checkpoints/final_checkpoint.pt"
    threads: 4
    resources:
        mem_mb = 128000,
        runtime = 120,
        slurm_partition = "gpu",
        gpu = 1
    log:
        f"{RUNS}/logs/biological_validation/plasticity.log"
    shell:
        """
        # Check if no_niche checkpoint exists (optional for niche resolution analysis)
        NO_NICHE_ARG=""
        if [ -f "{params.no_niche_ckpt}" ]; then
            NO_NICHE_ARG="--checkpoint_no_niche {params.no_niche_ckpt}"
        fi

        python -m stagebridge.pipelines.run_plasticity_validation \
            --checkpoint {input.checkpoint} \
            $NO_NICHE_ARG \
            --data_dir {params.canonical_dir} \
            --output_dir {params.plasticity_dir} \
            2>&1 | tee {log}
        """


