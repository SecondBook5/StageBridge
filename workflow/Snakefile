    params:
        fold=lambda w: w.fold,
        seed=lambda w: w.seed,
        run_dir=lambda w: f"{OUTPUT_DIR}/inference/full/fold_{w.fold}/seed_{w.seed}",
    resources:
        mem_mb=256000,
        runtime=240,  # 4 hours
        slurm_partition="gpu",
        gpu=1,
    shell:
        """
        python -m stagebridge.pipelines.infer \
