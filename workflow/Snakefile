# INTERPRETATION (POST-TRAINING ANALYSIS)
# =============================================================================

rule interpret:
    """Run post-training interpretation analysis.

    Includes:
    - Token ablation analysis (contribution of each token type)
    - Attention pattern extraction (spatial attention decay, reference balance)
    - Interaction network inference (cell-cell communication patterns)
    - Trajectory visualization (flow fields, fate probabilities)
    - Manifold comparison (embedding quality analysis)

    Uses fold 0, first seed as representative.
    """
    input:
        checkpoint=f"{OUTPUT_DIR}/full/fold_0/seed_{SEEDS[0]}/checkpoints/best_checkpoint.pt",
        neighborhoods=f"{DATA_DIR}/neighborhoods.parquet",
    output:
        summary=f"{OUTPUT_DIR}/interpretation/interpretation_summary.json",
        ablation=f"{OUTPUT_DIR}/interpretation/ablation_results.json",
        attention=f"{OUTPUT_DIR}/interpretation/attention_summary.json",
    params:
        output_dir=f"{OUTPUT_DIR}/interpretation",
    resources:
        mem_mb=256000,
        runtime=480,  # 8 hours
        slurm_partition="gpu",
        gpu=1,
    shell:
        """
        python scripts/run_interpretation.py \
            --checkpoint {input.checkpoint} \
            --data-dir {DATA_DIR} \
            --output-dir {params.output_dir} \
            --fold-idx 0 \
            --all
        """


