"""StageBridge Snakemake Pipeline.

This orchestrates the full StageBridge experiment:
1. Data validation
2. Two-stage training: SSL pretraining -> Transition model (per fold x seed)
3. Frozen encoder ablation (tests SSL representation quality)
4. Train baselines (per fold, per baseline)
5. Run ablations (per fold, per ablation)
6. Inference (held-out test set)
7. Evaluation
8. Cross-validation aggregation
9. Generate comparison reports

TWO-STAGE TRAINING:
    STAGE 1 (SSL): Masked receiver reconstruction from niche context
    STAGE 2 (Transition): OT-CFM flow matching for stage transitions

HPC Paths:
    Data: /data1/chaunzt1/stagebridge/processed/luad_evo
    Output: /data1/chaunzt1/stagebridge/outputs/v1
    HLCA: /data1/chaunzt1/stagebridge/processed/HLCA
    LuCA: /data1/chaunzt1/stagebridge/processed/LuCA

Usage:
    snakemake --profile workflow/slurm --jobs 20
    snakemake -n  # Dry run
    snakemake --dag | dot -Tpng > dag.png  # Visualize DAG
"""

import os
from pathlib import Path

# Load config
configfile: "workflow/config.yaml"

# Shell prefix: activate conda environment for most rules
# NOTE: Rules with `conda:` directive must NOT use shell.prefix - they set shell.prefix("")
shell.prefix("module load miniforge3 && eval \"$(conda shell.bash hook)\" && conda activate /scratch/chaunzt1/envs/stagebridge_env && ")

# =============================================================================
# PATH CONFIGURATION
# =============================================================================

# HPC paths (from config, can be overridden via --config)
DATA_ROOT = config["paths"]["data_root"]
DATA_DIR = config["paths"]["data_dir"]
OUTPUT_DIR = config["paths"]["output_dir"]
RESULTS_DIR = config["paths"]["results_dir"]
FIGURES_DIR = config["paths"]["figures_dir"]
HLCA_DIR = config["paths"]["hlca_dir"]
LUCA_DIR = config["paths"]["luca_dir"]

# Experiment settings
N_FOLDS = config["experiment"]["n_folds"]
N_SEEDS = config["experiment"].get("n_seeds", 3)
BASE_SEED = config["experiment"]["seed"]  # Base seed, actual seeds are BASE_SEED + i

FOLDS = list(range(N_FOLDS))
SEEDS = [BASE_SEED + i for i in range(N_SEEDS)]  # e.g., [42, 43, 44] for 3 seeds
BASELINES = config.get("baselines", ["pooling", "deepsets", "set_transformer", "graphsage"])

# External competing methods (OT-based, trajectory methods)
# These use external packages and have different training loops
# EXTERNAL_METHODS = config.get("external_methods", ["moscot", "cellrank", "commot"])
EXTERNAL_METHODS = []  # Disabled - external baselines not needed for V1
ABLATIONS = config.get("ablations", [
    "no_niche",
    "no_distance",
    "no_gate",
    "random_niche",  # Shuffle niche assignments to test spatial structure
    "hlca_only",
    "luca_only",
    "frozen_encoder",
    "no_ring_pooling",
    "no_context_refiner",
    # GW fusion ablations
    "no_gw_fusion",
    "gw_learned",
    # Evolution branch
    "no_evolution",
])


# =============================================================================
# HELPER FUNCTIONS
# =============================================================================

def get_checkpoint_path(model_type, fold, seed, ablation=None, baseline=None):
    """Get checkpoint path for a model."""
    if model_type == "full":
        return f"{OUTPUT_DIR}/full/fold_{fold}/seed_{seed}/checkpoints/best_checkpoint.pt"
    elif model_type == "baseline":
        return f"{OUTPUT_DIR}/baselines/{baseline}/fold_{fold}/seed_{seed}/checkpoints/{baseline}_final.pt"
    elif model_type == "ablation":
        return f"{OUTPUT_DIR}/ablations/{ablation}/fold_{fold}/seed_{seed}/checkpoints/best_checkpoint.pt"
    else:
        raise ValueError(f"Unknown model type: {model_type}")


# =============================================================================
# DEFAULT TARGET
# =============================================================================

rule all:
    input:
        # HPO (run first to get best hyperparameters)
        f"{OUTPUT_DIR}/hpo/best_params.json",
        # Full model trained on all folds x seeds (5 folds x 3 seeds = 15 runs)
        expand(f"{OUTPUT_DIR}/full/fold_{{fold}}/seed_{{seed}}/training_summary.json",
               fold=FOLDS, seed=SEEDS),
        # All baselines on all folds x seeds
        expand(f"{OUTPUT_DIR}/baselines/{{baseline}}/fold_{{fold}}/seed_{{seed}}/baseline_{{baseline}}.json",
               baseline=BASELINES, fold=FOLDS, seed=SEEDS),
        # All ablations on all folds x seeds
        expand(f"{OUTPUT_DIR}/ablations/{{ablation}}/fold_{{fold}}/seed_{{seed}}/ablation_{{ablation}}.json",
               ablation=ABLATIONS, fold=FOLDS, seed=SEEDS),
        # External methods (moscot, cellrank, commot) - per fold only (no seeds, they're deterministic)
        expand(f"{OUTPUT_DIR}/external/{{method}}/fold_{{fold}}/{{method}}_results.json",
               method=EXTERNAL_METHODS, fold=FOLDS),
        # Evaluation aggregated across seeds (per fold)
        expand(f"{OUTPUT_DIR}/evaluation/full/fold_{{fold}}/evaluation.json", fold=FOLDS),
        # Final comparison report
        f"{RESULTS_DIR}/comparison_report.json",
        # Results summary (one-stop-shop)
        f"{RESULTS_DIR}/results_summary.json",
        f"{RESULTS_DIR}/results_summary.csv",
        f"{RESULTS_DIR}/results_summary.md",
        # Publication figures
        f"{FIGURES_DIR}/fig1_architecture.pdf",
        f"{FIGURES_DIR}/fig2_training_baselines.pdf",
        f"{FIGURES_DIR}/fig3_ablations.pdf",
        f"{FIGURES_DIR}/fig4_embedding_flow.pdf",
        f"{FIGURES_DIR}/fig5_biological_validation.pdf",
        f"{FIGURES_DIR}/fig6_phase_portrait.pdf",
        f"{FIGURES_DIR}/fig7_trajectories.pdf",
        f"{FIGURES_DIR}/fig8_spatial_attention.pdf",
        f"{FIGURES_DIR}/fig9_novel_biology.pdf",


# =============================================================================
# DATA PREPARATION
# =============================================================================

# Input paths for data preparation
RAW_CELLS = config["paths"].get("raw_cells")
DESTVI_LUCA = config["paths"].get("destvi_luca")
DESTVI_HLCA = config["paths"].get("destvi_hlca")
PROGRESSION_SCORES = config["paths"].get("progression_scores")
SNRNA_H5AD = config["paths"].get("snrna_h5ad")  # Optional: for h5ad-based features
EVOLUTION_FEATURES = config["paths"].get("evolution_features")  # WES + clonal features

# Output directory for data preparation (separate from canonical data_dir to avoid cycles)
# By default, outputs to a 'prepared/' subdirectory. Override with prep_output_dir config.
PREP_OUTPUT_DIR = config["paths"].get("prep_output_dir", f"{DATA_ROOT}/prepared")

rule prepare_data:
    """Prepare data: build neighborhoods with raw cells, add cell types and progression scores.

    This rule prepares data from raw inputs. To avoid cyclic dependencies when raw_cells
    is in the same directory as data_dir, set prep_output_dir to a different location:
        snakemake prepare_data --config prep_output_dir=/path/to/output

    Optionally computes h5ad-based biological features (EMT, senescence, SASP) if --h5ad provided.
    Optionally adds evolution features (WES + clonal) if --evolution provided.
    """
    input:
        cells=ancient(RAW_CELLS) if RAW_CELLS and RAW_CELLS != "null" else [],
        destvi_luca=ancient(DESTVI_LUCA) if DESTVI_LUCA and DESTVI_LUCA != "null" else [],
        destvi_hlca=ancient(DESTVI_HLCA) if DESTVI_HLCA and DESTVI_HLCA != "null" else [],
        progression=ancient(PROGRESSION_SCORES) if PROGRESSION_SCORES and PROGRESSION_SCORES != "null" else [],
        evolution=ancient(EVOLUTION_FEATURES) if EVOLUTION_FEATURES and EVOLUTION_FEATURES != "null" else [],
    output:
        cells=f"{PREP_OUTPUT_DIR}/cells.parquet",
        neighborhoods=f"{PREP_OUTPUT_DIR}/neighborhoods.parquet",
        manifest=f"{PREP_OUTPUT_DIR}/split_manifest.json",
        summary=f"{PREP_OUTPUT_DIR}/prep_summary.json",
    params:
        output_dir=PREP_OUTPUT_DIR,
        h5ad=SNRNA_H5AD,
        evolution=EVOLUTION_FEATURES,
    resources:
        mem_mb=256000,
        runtime=480,  # 8 hours
        slurm_partition="gpu",
        gpu=1,
    shell:
        """
        python -m stagebridge.pipelines.prepare_data \
            --cells {input.cells} \
            --destvi-luca {input.destvi_luca} \
            --destvi-hlca {input.destvi_hlca} \
            --progression {input.progression} \
            --output-dir {params.output_dir} \
            --figures \
            $([ -n "{params.h5ad}" ] && echo "--h5ad {params.h5ad}") \
            $([ -n "{params.evolution}" ] && echo "--evolution {params.evolution}")
        """


rule prepare_data_with_liana:
    """Extended data prep including LIANA L-R analysis (slow, ~30-60 min).

    Use this rule when you need ligand-receptor interaction scores.
    Run explicitly: snakemake prepare_data_with_liana --config raw_cells=/path/to/cells.parquet
    """
    input:
        cells=ancient(RAW_CELLS) if RAW_CELLS and RAW_CELLS != "null" else [],
        destvi_luca=ancient(DESTVI_LUCA) if DESTVI_LUCA and DESTVI_LUCA != "null" else [],
        destvi_hlca=ancient(DESTVI_HLCA) if DESTVI_HLCA and DESTVI_HLCA != "null" else [],
        progression=ancient(PROGRESSION_SCORES) if PROGRESSION_SCORES and PROGRESSION_SCORES != "null" else [],
    output:
        cells=f"{DATA_DIR}/liana/cells.parquet",
        neighborhoods=f"{DATA_DIR}/liana/neighborhoods.parquet",
        manifest=f"{DATA_DIR}/liana/split_manifest.json",
        summary=f"{DATA_DIR}/liana/prep_summary.json",
        liana_results=f"{DATA_DIR}/liana/liana_interactions.parquet",
    params:
        output_dir=f"{DATA_DIR}/liana",
        h5ad=SNRNA_H5AD,
    resources:
        mem_mb=256000,
        runtime=720,  # 12 hours (LIANA is slow)
        slurm_partition="gpu",
        gpu=1,
    shell:
        """
        python -m stagebridge.pipelines.prepare_data \
            --cells {input.cells} \
            --destvi-luca {input.destvi_luca} \
            --destvi-hlca {input.destvi_hlca} \
            --progression {input.progression} \
            --output-dir {params.output_dir} \
            --h5ad {params.h5ad} \
            --run-liana \
            --figures
        """


# =============================================================================
# GROMOV-WASSERSTEIN PRECOMPUTATION
# =============================================================================

# Directory for GW precomputed alignment
GW_ALIGNMENT_DIR = config["paths"].get("gw_alignment_dir", f"{OUTPUT_DIR}/gw_alignment")
GW_N_REFERENCE_CELLS = config.get("gw_precompute", {}).get("n_reference_cells", 5000)
GW_SINKHORN_REG = config.get("gw_precompute", {}).get("sinkhorn_reg", 0.05)
GW_ITERS = config.get("gw_precompute", {}).get("gw_iters", 50)

rule precompute_gw:
    """Precompute Gromov-Wasserstein alignment between HLCA and LuCA.

    This is required for proper GW fusion (gw_fusion_type="precompute_gw").
    GW finds structure-preserving alignment between reference atlases and
    computes barycentric fusion for use during training.

    Can be run independently:
        snakemake precompute_gw --profile workflow/slurm

    The alignment is computed once and reused across all folds/seeds.
    """
    input:
        validated=f"{OUTPUT_DIR}/.data_validated",
        cells=f"{DATA_DIR}/cells.parquet",
    output:
        coupling=f"{GW_ALIGNMENT_DIR}/gw_coupling.pt",
        fusion=f"{GW_ALIGNMENT_DIR}/barycentric_fusion.pt",
        metadata=f"{GW_ALIGNMENT_DIR}/gw_metadata.json",
        reference=f"{GW_ALIGNMENT_DIR}/reference_data.npz",
    params:
        output_dir=GW_ALIGNMENT_DIR,
        n_reference_cells=GW_N_REFERENCE_CELLS,
        sinkhorn_reg=GW_SINKHORN_REG,
        gw_iters=GW_ITERS,
    resources:
        mem_mb=256000,
        runtime=480,  # 8 hours (GW on 5k cells is intensive)
        slurm_partition="gpu",
        gpu=1,
    shell:
        """
        python scripts/precompute_gw_alignment.py \
            --cells {input.cells} \
            --output-dir {params.output_dir} \
            --n-reference-cells {params.n_reference_cells} \
            --sinkhorn-reg {params.sinkhorn_reg} \
            --gw-iters {params.gw_iters} \
            --device cuda
        """


# =============================================================================
# DATA VALIDATION
# =============================================================================

rule validate_data:
    """Validate data directory contract."""
    input:
        cells=f"{DATA_DIR}/cells.parquet",
        neighborhoods=f"{DATA_DIR}/neighborhoods.parquet",
        manifest=f"{DATA_DIR}/split_manifest.json",
    output:
        touch(f"{OUTPUT_DIR}/.data_validated")
    resources:
        mem_mb=256000,
        runtime=60,
        slurm_partition="gpu",
    shell:
        """
        python -c "
from stagebridge.contracts import validate_contract
validate_contract('{DATA_DIR}')
print('Data contract validated successfully')
"
        """


# =============================================================================
# HYPERPARAMETER OPTIMIZATION
# =============================================================================

# Whether to use pretrained GW fusion (requires precompute_gw to run first)
USE_PRETRAINED_GW = config.get("gw_precompute", {}).get("use_pretrained", True)

rule hpo:
    """Hyperparameter optimization using Optuna.

    Searches over model architecture and training hyperparameters.
    Outputs best_params.json which can be used by subsequent training runs.

    If GW precomputation exists, HPO will search over pretrained GW fusion.
    """
    input:
        validated=f"{OUTPUT_DIR}/.data_validated",
        neighborhoods=f"{DATA_DIR}/neighborhoods.parquet",
        # Optional: GW precomputation (if use_pretrained=True in config)
        gw_checkpoint=f"{GW_ALIGNMENT_DIR}/gw_coupling.pt" if USE_PRETRAINED_GW else [],
    output:
        best_params=f"{OUTPUT_DIR}/hpo/best_params.json",
        history=f"{OUTPUT_DIR}/hpo/optimization_history.json",
    params:
        hpo_dir=f"{OUTPUT_DIR}/hpo",
        n_trials=config.get("hpo", {}).get("n_trials", 30),
        n_epochs=config.get("hpo", {}).get("n_epochs_per_trial", 10),
        batch_size=config["trainer"]["batch_size"],
        gw_checkpoint_dir=GW_ALIGNMENT_DIR if USE_PRETRAINED_GW else "",
    resources:
        mem_mb=256000,
        runtime=2880,  # 48 hours (GW fusion makes trials expensive)
        slurm_partition="gpu",
        gpu=1,
    shell:
        """
        python -m stagebridge.pipelines.run_hpo \
            --data-dir {DATA_DIR} \
            --output-dir {params.hpo_dir} \
            --n-trials {params.n_trials} \
            --n-epochs {params.n_epochs} \
            --batch-size {params.batch_size} \
            --seed {BASE_SEED} \
            --storage sqlite:///{params.hpo_dir}/optuna.db \
            --study-name stagebridge_hpo \
            $([ -n "{params.gw_checkpoint_dir}" ] && echo "--gw-checkpoint {params.gw_checkpoint_dir}")
        """


# =============================================================================
# TRAINING: FULL MODEL
# =============================================================================

rule train_full:
    """Train full StageBridge model with two-stage training.

    STAGE 1 (SSL): Masked receiver reconstruction
    STAGE 2 (Transition): OT-CFM flow matching

    GW fusion is enabled by default for the full model.
    If gw_precompute.use_pretrained=true, uses pretrained GW alignment.
    Uses best hyperparameters from HPO.
    Runs for each fold x seed combination.
    """
    input:
        validated=f"{OUTPUT_DIR}/.data_validated",
        neighborhoods=f"{DATA_DIR}/neighborhoods.parquet",
        hpo_params=f"{OUTPUT_DIR}/hpo/best_params.json",
        # Optional: GW precomputation (if use_pretrained=True in config)
        gw_checkpoint=f"{GW_ALIGNMENT_DIR}/gw_coupling.pt" if USE_PRETRAINED_GW else [],
    output:
        summary=f"{OUTPUT_DIR}/full/fold_{{fold}}/seed_{{seed}}/training_summary.json",
        checkpoint=f"{OUTPUT_DIR}/full/fold_{{fold}}/seed_{{seed}}/checkpoints/best_checkpoint.pt",
    params:
        fold=lambda w: w.fold,
        seed=lambda w: w.seed,
        run_dir=lambda w: f"{OUTPUT_DIR}/full/fold_{w.fold}/seed_{w.seed}",
        ssl_epochs=config["trainer"]["ssl_epochs"],
        transition_epochs=config["trainer"]["transition_epochs"],
        batch_size=config["trainer"]["batch_size"],
        ssl_checkpoint=lambda w: f"{OUTPUT_DIR}/full/fold_{w.fold}/seed_{w.seed}/checkpoints/ssl_pretrained.pt",
    resources:
        mem_mb=256000,
        runtime=1440,  # 24 hours
        slurm_partition="gpu",
    shell:
        """
        if [ -f "{params.ssl_checkpoint}" ]; then
            echo "Resuming from SSL checkpoint: {params.ssl_checkpoint}"
            python -m stagebridge.training.trainer \
                --data-dir {DATA_DIR} \
                --output-dir {params.run_dir} \
                --fold-idx {params.fold} \
                --seed {params.seed} \
                --ssl-epochs {params.ssl_epochs} \
                --transition-epochs {params.transition_epochs} \
                --batch-size {params.batch_size} \
                --hpo-params {input.hpo_params} \
                --resume {params.ssl_checkpoint}
        else
            echo "No SSL checkpoint found, training from scratch"
            python -m stagebridge.training.trainer \
                --data-dir {DATA_DIR} \
                --output-dir {params.run_dir} \
                --fold-idx {params.fold} \
                --seed {params.seed} \
                --ssl-epochs {params.ssl_epochs} \
                --transition-epochs {params.transition_epochs} \
                --batch-size {params.batch_size} \
                --hpo-params {input.hpo_params} \
                --data-parallel
        fi
        """


# =============================================================================
# TRAINING: BASELINES
# =============================================================================

rule train_baseline:
    """Train a baseline model for comparison.

    Runs for each baseline x fold x seed combination.
    """
    input:
        validated=f"{OUTPUT_DIR}/.data_validated",
        neighborhoods=f"{DATA_DIR}/neighborhoods.parquet",
    output:
        result=f"{OUTPUT_DIR}/baselines/{{baseline}}/fold_{{fold}}/seed_{{seed}}/baseline_{{baseline}}.json",
        checkpoint=f"{OUTPUT_DIR}/baselines/{{baseline}}/fold_{{fold}}/seed_{{seed}}/checkpoints/{{baseline}}_final.pt",
    params:
        baseline=lambda w: w.baseline,
        fold=lambda w: w.fold,
        seed=lambda w: w.seed,
        run_dir=lambda w: f"{OUTPUT_DIR}/baselines/{w.baseline}/fold_{w.fold}/seed_{w.seed}",
    resources:
        mem_mb=256000,
        runtime=720,  # 12 hours
        slurm_partition="gpu",
        gpu=1,
    shell:
        """
        python -m stagebridge.baselines.train \
            --baseline {params.baseline} \
            --data-dir {DATA_DIR} \
            --output-dir {params.run_dir} \
            --fold-idx {params.fold} \
            --seed {params.seed}
        """


# =============================================================================
# ABLATIONS
# =============================================================================

rule run_ablation:
    """Run an ablation experiment.

    Uses the same HPO params as train_full for fair comparison.
    Only frozen_encoder ablation requires the full model checkpoint.
    Resumes from ssl_pretrained.pt if it exists (skips SSL phase).
    """
    input:
        validated=f"{OUTPUT_DIR}/.data_validated",
        neighborhoods=f"{DATA_DIR}/neighborhoods.parquet",
        hpo_params=f"{OUTPUT_DIR}/hpo/best_params.json",
        # Only frozen_encoder needs the checkpoint; others can run in parallel with full training
        full_checkpoint=lambda w: f"{OUTPUT_DIR}/full/fold_{w.fold}/seed_{w.seed}/checkpoints/best_checkpoint.pt" if w.ablation == "frozen_encoder" else [],
    output:
        result=f"{OUTPUT_DIR}/ablations/{{ablation}}/fold_{{fold}}/seed_{{seed}}/ablation_{{ablation}}.json",
        checkpoint=f"{OUTPUT_DIR}/ablations/{{ablation}}/fold_{{fold}}/seed_{{seed}}/checkpoints/best_checkpoint.pt",
    params:
        ablation=lambda w: w.ablation,
        fold=lambda w: w.fold,
        seed=lambda w: w.seed,
        run_dir=lambda w: f"{OUTPUT_DIR}/ablations/{w.ablation}/fold_{w.fold}/seed_{w.seed}",
        # Pass checkpoint arg only for frozen_encoder
        checkpoint_arg=lambda w: f"--pretrained-checkpoint {OUTPUT_DIR}/full/fold_{w.fold}/seed_{w.seed}/checkpoints/best_checkpoint.pt" if w.ablation == "frozen_encoder" else "",
        # Resume from ssl_pretrained.pt if it exists
        resume_arg=lambda w: f"--resume {OUTPUT_DIR}/ablations/{w.ablation}/fold_{w.fold}/seed_{w.seed}/checkpoints/ssl_pretrained.pt",
    resources:
        mem_mb=256000,
        runtime=1440,  # 24 hours (transition only, not full training)
        slurm_partition="gpu",
        gpu=1,
    shell:
        """
        python -m stagebridge.evaluation.ablation \
            --ablation {params.ablation} \
            --data-dir {DATA_DIR} \
            --output-dir {params.run_dir} \
            --fold-idx {params.fold} \
            --seed {params.seed} \
            --hpo-params {input.hpo_params} \
            {params.checkpoint_arg} \
            {params.resume_arg}
        """


# =============================================================================
# EXTERNAL BASELINES (moscot, cellrank, commot)
# =============================================================================
# Each has its own conda environment to avoid dependency conflicts

rule run_moscot:
    """Run moscot temporal OT for trajectory inference.

    moscot learns transport plans between timepoints using optimal transport.
    Unlike StageBridge, it does NOT learn a velocity field or condition on niche.
    Uses pre-created snakemake conda env to avoid shell.prefix conflicts.
    """
    input:
        validated=f"{OUTPUT_DIR}/.data_validated",
        neighborhoods=f"{DATA_DIR}/neighborhoods.parquet",
        script="scripts/run_external_baseline.py",
    output:
        result=f"{OUTPUT_DIR}/external/moscot/fold_{{fold}}/moscot_results.json",
    params:
        fold=lambda w: w.fold,
        run_dir=lambda w: f"{OUTPUT_DIR}/external/moscot/fold_{w.fold}",
        spatial_h5ad=config["paths"].get("spatial_h5ad", ""),
        conda_env="/home/booka/StageBridge/.snakemake/conda/7f97f8103f26312b70c6cc5f512a62e8_",
    resources:
        mem_mb=256000,
        runtime=240,  # 4 hours
        slurm_partition="gpu",
        gpu=1,
    shell:
        """
        conda deactivate 2>/dev/null || true
        conda run -p {params.conda_env} python {input.script} \
            --method moscot \
            --data-dir {DATA_DIR} \
            --output-dir {params.run_dir} \
            --fold-idx {params.fold} \
            --spatial-h5ad {params.spatial_h5ad}
        """


rule run_cellrank:
    """Run CellRank for trajectory inference.

    CellRank uses CytoTRACE to infer transition probabilities from gene expression.
    Requires snRNA h5ad with gene expression data.
    Uses pre-created snakemake conda env.
    """
    input:
        validated=f"{OUTPUT_DIR}/.data_validated",
        neighborhoods=f"{DATA_DIR}/neighborhoods.parquet",
        script="scripts/run_external_baseline.py",
    output:
        result=f"{OUTPUT_DIR}/external/cellrank/fold_{{fold}}/cellrank_results.json",
    params:
        fold=lambda w: w.fold,
        run_dir=lambda w: f"{OUTPUT_DIR}/external/cellrank/fold_{w.fold}",
        spatial_h5ad=config["paths"].get("spatial_h5ad", ""),
        conda_env="/home/booka/StageBridge/.snakemake/conda/10fc23470d505b4d77b5fcdb58ef520b_",
    resources:
        mem_mb=256000,
        runtime=240,  # 4 hours
        slurm_partition="gpu",
        gpu=1,
    shell:
        """
        conda deactivate 2>/dev/null || true
        conda run -p {params.conda_env} python {input.script} \
            --method cellrank \
            --data-dir {DATA_DIR} \
            --output-dir {params.run_dir} \
            --fold-idx {params.fold} \
            --spatial-h5ad {params.spatial_h5ad}
        """


rule run_commot:
    """Run COMMOT for cell-cell communication analysis.

    COMMOT uses optimal transport to infer spatial communication patterns.
    Requires numpy<2.0.
    Uses pre-created snakemake conda env.
    """
    input:
        validated=f"{OUTPUT_DIR}/.data_validated",
        neighborhoods=f"{DATA_DIR}/neighborhoods.parquet",
        script="scripts/run_external_baseline.py",
    output:
        result=f"{OUTPUT_DIR}/external/commot/fold_{{fold}}/commot_results.json",
    params:
        fold=lambda w: w.fold,
        run_dir=lambda w: f"{OUTPUT_DIR}/external/commot/fold_{w.fold}",
        spatial_h5ad=config["paths"].get("spatial_h5ad", ""),
        conda_env="/home/booka/StageBridge/.snakemake/conda/e50bd7ca0d8392d60f1d7039b29f78e1_",
    resources:
        mem_mb=256000,
        runtime=480,  # 8 hours - COMMOT is slow on large spatial data
        slurm_partition="gpu",
        gpu=1,
    shell:
        """
        conda deactivate 2>/dev/null || true
        conda run -p {params.conda_env} python {input.script} \
            --method commot \
            --data-dir {DATA_DIR} \
            --output-dir {params.run_dir} \
            --fold-idx {params.fold} \
            --spatial-h5ad {params.spatial_h5ad}
        """


