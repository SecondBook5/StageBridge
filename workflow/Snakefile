rule validate_data:
    """Validate data directory contract."""
    input:
        cells=f"{DATA_DIR}/cells.parquet",
        neighborhoods=f"{DATA_DIR}/neighborhoods.parquet",
        manifest=f"{DATA_DIR}/split_manifest.json",
    output:
        touch(f"{OUTPUT_DIR}/.data_validated")
    shell:
        """
        python -c "
from stagebridge.contracts import validate_contract
validate_contract('{DATA_DIR}')
print('Data contract validated successfully')
"
        """


# =============================================================================
# TRAINING: FULL MODEL
# =============================================================================

rule train_full:
    """Train full StageBridge model with two-stage training.

    STAGE 1 (SSL): Masked receiver reconstruction
    STAGE 2 (Transition): OT-CFM flow matching
    """
    input:
        validated=f"{OUTPUT_DIR}/.data_validated",
        neighborhoods=f"{DATA_DIR}/neighborhoods.parquet",
    output:
        summary=f"{OUTPUT_DIR}/full/fold_{{fold}}/training_summary.json",
        checkpoint=f"{OUTPUT_DIR}/full/fold_{{fold}}/checkpoints/best_checkpoint.pt",
    params:
        fold=lambda w: w.fold,
        run_dir=lambda w: f"{OUTPUT_DIR}/full/fold_{w.fold}",
        ssl_epochs=config["trainer"]["ssl_epochs"],
        transition_epochs=config["trainer"]["transition_epochs"],
        lr=config["trainer"]["learning_rate"],
        batch_size=config["trainer"]["batch_size"],
    resources:
        gpu=1,
        runtime=2880,  # 48 hours
        mem_mb=64000,
    shell:
        """
        python -m stagebridge.training.trainer \
            --data-dir {DATA_DIR} \
            --output-dir {params.run_dir} \
            --fold-idx {params.fold} \
            --seed {SEED} \
            --ssl-epochs {params.ssl_epochs} \
            --transition-epochs {params.transition_epochs} \
            --learning-rate {params.lr} \
            --batch-size {params.batch_size}
        """


# =============================================================================
# TRAINING: BASELINES
# =============================================================================

rule train_baseline:
    """Train a baseline model for comparison."""
    input:
        validated=f"{OUTPUT_DIR}/.data_validated",
        neighborhoods=f"{DATA_DIR}/neighborhoods.parquet",
    output:
        result=f"{OUTPUT_DIR}/baselines/{{baseline}}/fold_{{fold}}/baseline_{{baseline}}.json",
        checkpoint=f"{OUTPUT_DIR}/baselines/{{baseline}}/fold_{{fold}}/checkpoints/{{baseline}}_final.pt",
    params:
        baseline=lambda w: w.baseline,
        fold=lambda w: w.fold,
        run_dir=lambda w: f"{OUTPUT_DIR}/baselines/{w.baseline}/fold_{w.fold}",
    resources:
        gpu=1,
        runtime=720,  # 12 hours
        mem_mb=32000,
    shell:
        """
        python -m stagebridge.baselines.train \
            --baseline {params.baseline} \
            --data-dir {DATA_DIR} \
            --output-dir {params.run_dir} \
            --fold-idx {params.fold} \
            --seed {SEED}
        """


# =============================================================================
# ABLATIONS
# =============================================================================

rule run_ablation:
    """Run an ablation experiment."""
    input:
        validated=f"{OUTPUT_DIR}/.data_validated",
        neighborhoods=f"{DATA_DIR}/neighborhoods.parquet",
    output:
        result=f"{OUTPUT_DIR}/ablations/{{ablation}}/fold_{{fold}}/ablation_{{ablation}}.json",
        checkpoint=f"{OUTPUT_DIR}/ablations/{{ablation}}/fold_{{fold}}/checkpoints/best_checkpoint.pt",
    params:
        ablation=lambda w: w.ablation,
        fold=lambda w: w.fold,
        run_dir=lambda w: f"{OUTPUT_DIR}/ablations/{w.ablation}/fold_{w.fold}",
    resources:
        gpu=1,
        runtime=1440,  # 24 hours
        mem_mb=64000,
    shell:
        """
        python -m stagebridge.evaluation.ablation \
            --ablation {params.ablation} \
            --data-dir {DATA_DIR} \
            --output-dir {params.run_dir} \
            --fold-idx {params.fold} \
            --seed {SEED}
        """


