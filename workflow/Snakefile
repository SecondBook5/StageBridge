rule infer_full:
    """Run inference with full model.

    Runs per fold x seed. Predictions are later aggregated for evaluation.
    Saves embeddings and attention weights for downstream analysis.
    """
    input:
        checkpoint=f"{OUTPUT_DIR}/full/fold_{{fold}}/seed_{{seed}}/checkpoints/best_checkpoint.pt",
        neighborhoods=f"{DATA_DIR}/neighborhoods.parquet",
    output:
