# =============================================================================
# Stage 5d-gamma: Ablation Held-Out Evaluation
# =============================================================================
# Run held-out evaluation on ablation models too

rule ablation_heldout_evaluation:
    """Run held-out test evaluation on ablation model."""
    input:
        results = f"{ABLATIONS}/{{ablation}}/results.json",
        cells = f"{CANONICAL}/cells.parquet",
        neighborhoods = f"{CANONICAL}/neighborhoods.parquet",
        splits = f"{CANONICAL}/split_manifest.json"
    output:
        evaluation = f"{ABLATIONS}/{{ablation}}/evaluation/heldout_evaluation.json"
    wildcard_constraints:
        ablation = "|".join(ABLATIONS_LIST)
    params:
        canonical_dir = CANONICAL
    threads: 4
    resources:
        mem_mb = 64000,
        runtime = 60,
        slurm_partition = "gpu",
        gpu = 1
    log:
        f"{RUNS}/logs/ablations/eval_{{ablation}}.log"
    shell:
        """
        # Find the checkpoint (could be final or best)
        CKPT=""
        for f in {ABLATIONS}/{wildcards.ablation}/checkpoints/best_checkpoint.pt \
                 {ABLATIONS}/{wildcards.ablation}/checkpoints/final_checkpoint.pt \
                 {ABLATIONS}/{wildcards.ablation}/best_model.pt; do
            if [ -f "$f" ]; then
                CKPT="$f"
                break
            fi
        done

        if [ -z "$CKPT" ]; then
            echo "ERROR: No checkpoint found for {wildcards.ablation}"
            exit 1
        fi

        python workflow/scripts/run_heldout_evaluation.py \
            --checkpoint $CKPT \
            --data_dir {params.canonical_dir} \
            --output_dir {ABLATIONS}/{wildcards.ablation}/evaluation \
            --fold 0 \
            2>&1 | tee {log}
        """


rule aggregate_ablation_evaluation:
    """Aggregate held-out evaluation across all ablations."""
    input:
        evaluations = expand(
            f"{ABLATIONS}/{{ablation}}/evaluation/heldout_evaluation.json",
            ablation=ABLATIONS_LIST
        ),
        full_model = f"{TRAINING}/evaluation/heldout_summary.json"
    output:
        summary = f"{ABLATIONS}/evaluation/heldout_summary.json",
        latex = f"{ABLATIONS}/evaluation/table_ablation_evaluation.tex"
    threads: 2
    resources:
        mem_mb = 8000,
        runtime = 15
    log:
        f"{RUNS}/logs/ablations/aggregate_eval.log"
    shell:
        """
        python -c "
import json
from pathlib import Path
import numpy as np

# Load full model baseline
with open('{input.full_model}') as f:
    full_model = json.load(f)

ablation_results = {{}}
for ablation in {ABLATIONS_LIST!r}:
    eval_path = Path('{ABLATIONS}') / ablation / 'evaluation' / 'heldout_evaluation.json'
    if eval_path.exists():
        with open(eval_path) as f:
            data = json.load(f)
            ablation_results[ablation] = data.get('transition_metrics', {{}})

# Compute degradation vs full model
full_metrics = full_model.get('metrics', {{}})
degradations = {{}}
for ablation, metrics in ablation_results.items():
    degradations[ablation] = {{}}
    for key in ['wasserstein', 'mmd', 'stage_accuracy', 'auroc']:
        if key in metrics and key in full_metrics:
            full_val = full_metrics[key].get('mean', 0)
            abl_val = metrics.get(key, 0)
            if key in ['wasserstein', 'mmd']:
                # Lower is better
                degradations[ablation][key] = {{'ablation': abl_val, 'full': full_val, 'degradation_pct': (abl_val - full_val) / (abs(full_val) + 1e-10) * 100}}
            else:
                # Higher is better
                degradations[ablation][key] = {{'ablation': abl_val, 'full': full_val, 'degradation_pct': (full_val - abl_val) / (abs(full_val) + 1e-10) * 100}}

summary = {{'ablation_results': ablation_results, 'degradations': degradations}}
with open('{output.summary}', 'w') as f:
    json.dump(summary, f, indent=2)

# LaTeX table
lines = [r'\\begin{{table}}[htbp]', r'\\centering', r'\\caption{{Ablation Study: Held-Out Evaluation}}', r'\\begin{{tabular}}{{lccccc}}', r'\\toprule', r'Ablation & Wasserstein & MMD & Acc & AUROC & Degradation \\\\', r'\\midrule']
for ablation, metrics in ablation_results.items():
    w = metrics.get('wasserstein', 0)
    m = metrics.get('mmd', 0)
    a = metrics.get('stage_accuracy', 0)
    au = metrics.get('auroc', 0)
    deg = np.mean([abs(d.get('degradation_pct', 0)) for d in degradations.get(ablation, {{}}).values() if d])
    lines.append(f\"{ablation.replace('_', ' ')} & {w:.3f} & {m:.3f} & {a:.3f} & {au:.3f} & {deg:.1f}\\\\% \\\\\\\\\")
lines.extend([r'\\bottomrule', r'\\end{{tabular}}', r'\\end{{table}}'])
Path('{output.latex}').write_text('\\n'.join(lines))
" 2>&1 | tee {log}
        """


