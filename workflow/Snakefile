rule run_inference_for_figures:
    """Run inference to get embeddings, predictions, attention for figures."""
    input:
        checkpoint=f"{OUTPUT_DIR}/full/fold_0/checkpoints/best_checkpoint.pt",
        neighborhoods=f"{DATA_DIR}/neighborhoods.parquet",
    output:
        embeddings=f"{OUTPUT_DIR}/inference/figure_data/embeddings.parquet",
        predictions=f"{OUTPUT_DIR}/inference/figure_data/predictions.parquet",
        attention=f"{OUTPUT_DIR}/inference/figure_data/attention_weights.npz",
    params:
        run_dir=f"{OUTPUT_DIR}/inference/figure_data",
    resources:
        gpu=1,
        runtime=240,  # 4 hours
        mem_mb=32000,
    shell:
        """
        python -m stagebridge.pipelines.infer \
            --checkpoint {input.checkpoint} \
            --data-dir {DATA_DIR} \
            --output-dir {params.run_dir} \
            --fold-idx 0 \
            --save-embeddings \
            --save-attention
        """


