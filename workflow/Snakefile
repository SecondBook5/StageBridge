# =============================================================================
# StageBridge V1 Publication Pipeline - Snakemake Workflow
# =============================================================================
#
# A complete, reproducible pipeline for StageBridge V1.
#
# Usage:
#   # Dry run (see what would execute)
#   snakemake -n --cores 8
#
#   # Local execution
#   snakemake --cores 8
#
#   # HPC execution with SLURM
#   snakemake --profile slurm --jobs 20
#
#   # Generate DAG visualization
#   snakemake --dag | dot -Tpdf > dag.pdf
#
# =============================================================================

import os
from pathlib import Path

# Activate conda environment for all shell commands
# MKL_INTERFACE_LAYER=ILP64 needed for TACCO with large matrices (>2B elements)
shell.prefix("module load miniforge3 && eval \"$(conda shell.bash hook)\" && conda activate /scratch/chaunzt1/stagebridge_env && export MKL_INTERFACE_LAYER=ILP64 && ")

# =============================================================================
# Configuration
# =============================================================================

configfile: "workflow/config.yaml"

# Data paths
DATA = config.get("data_root", os.environ.get("DATA", "/scratch/chaunzt1/stagebridge"))
PROCESSED = f"{DATA}/processed/luad_evo"
REFERENCES = f"{DATA}/references"
RUNS = f"{DATA}/runs"

# Output directories
REF_GEOM = f"{PROCESSED}/reference_geometry"
SPATIAL = f"{RUNS}/spatial_benchmark"
CANONICAL = f"{PROCESSED}/canonical"
CLONAL = f"{RUNS}/clonal"
TRAINING = f"{RUNS}/v1_complete"
ABLATIONS = f"{RUNS}/ablations"
FIGURES = f"{RUNS}/publication_figures"

# Spatial backends to run
# Python backends: tangram, destvi, tacco, cell2location, marker_scoring
PYTHON_BACKENDS = ["tangram", "destvi", "tacco", "cell2location", "marker_scoring"]
# R backends (Paper 3): rctd, card, spotlight (require R packages: spacexr, CARD, SPOTlight)
R_BACKENDS = ["card", "rctd", "spotlight"]
SPATIAL_BACKENDS = PYTHON_BACKENDS + R_BACKENDS

# Label sources for spatial deconvolution ablation (HLCA vs LuCA cell types)
LABEL_SOURCES = ["hlca", "luca"]

# Cross-validation settings
FOLDS = [0, 1, 2, 3, 4]  # 5-fold CV
SEEDS = [42, 123, 456]   # 3 seeds per fold for variance estimation

# =============================================================================
# Final Targets (what we want to produce)
# =============================================================================

rule all:
    input:
        # Reference geometry
        f"{REF_GEOM}/fused_embedding.parquet",
        # Spatial benchmark
        f"{SPATIAL}/backend_comparison.json",
        # Clonal patterns (for H3 validation)
        f"{CLONAL}/clonal_patterns.json",
        # LIANA L-R analysis (H1.2 biological validation)
        f"{RUNS}/biological_validation/liana/liana_summary.json",
        # LIANA cell cycling post-hoc
        f"{RUNS}/biological_validation/liana/cycling_posthoc_summary.json",
        # Training (5-fold CV × 3 seeds, aggregated)
        f"{TRAINING}/aggregated/cv_results.json",
        f"{TRAINING}/aggregated/publication_metrics.json",
        # H3 hypothesis validation (clonal ground truth)
        f"{TRAINING}/h3_validation/h3_validation.json",
        # H1.3 plasticity validation
        f"{RUNS}/biological_validation/plasticity/plasticity_validation.json",
        # Baseline ladder comparison
        f"{TRAINING}/baselines/baseline_comparison.json",
        # Ablations
        f"{ABLATIONS}/ablation_summary.json",
        # Publication figures
        f"{FIGURES}/manifests/figure_manifest.json"


# =============================================================================
# Stage 1: HLCA Reference Mapping
# =============================================================================

rule hlca_mapping:
    input:
        query = f"{PROCESSED}/snrna_qc_normalized_with_ensg.h5ad",
        ref = f"{REFERENCES}/hlca/hlca_reference.h5ad"
    output:
        latent = f"{REF_GEOM}/hlca_mapping/hlca_latent.h5ad",
        labels = f"{REF_GEOM}/hlca_mapping/hlca_labels.parquet",
        report = f"{REF_GEOM}/hlca_mapping/mapping_report.json"
    params:
        model_dir = f"{REFERENCES}/hlca/hub_cache",
        data_root = DATA,
        output_dir = REF_GEOM
    threads: 8
    resources:
        mem_mb = 256000,
        runtime = 360,  # 6 hours (scArches surgery ~2-4h)
        slurm_partition = "gpu",
        gpu = 1
    log:
        f"{RUNS}/logs/reference/hlca_mapping.log"
    shell:
        """
        python -m stagebridge.pipelines.run_reference \
            --data-root {params.data_root} \
            --snrna {input.query} \
            --hlca {input.ref} \
            --hlca-model {params.model_dir} \
            --output-dir {params.output_dir} \
            --hlca-only \
            --hpc \
            --use-model-based \
            2>&1 | tee {log}
        """


# =============================================================================
# Stage 2: LuCA Reference Mapping (parallel with HLCA)
# =============================================================================

rule luca_mapping:
    input:
        query = f"{PROCESSED}/snrna_qc_normalized_with_ensg.h5ad",
        ref = f"{REFERENCES}/luca/luca_core_atlas.h5ad"
    params:
        model_dir = f"{REFERENCES}/luca/retrained_model/scanvi_model",
        data_root = DATA,
        output_dir = REF_GEOM
    output:
        latent = f"{REF_GEOM}/luca_mapping/luca_latent.h5ad",
        labels = f"{REF_GEOM}/luca_mapping/luca_labels.parquet",
        report = f"{REF_GEOM}/luca_mapping/mapping_report.json"
    threads: 8
    resources:
        mem_mb = 256000,
        runtime = 360,  # 6 hours (scArches surgery ~2-4h)
        slurm_partition = "gpu",
        gpu = 1
    log:
        f"{RUNS}/logs/reference/luca_mapping.log"
    shell:
        """
        python -m stagebridge.pipelines.run_reference \
            --data-root {params.data_root} \
            --snrna {input.query} \
            --luca {input.ref} \
            --luca-model {params.model_dir} \
            --output-dir {params.output_dir} \
            --luca-only \
            --hpc \
            --use-model-based \
            2>&1 | tee {log}
        """


# =============================================================================
# Stage 2b: Fuse Embeddings (after both HLCA and LuCA)
# =============================================================================

rule fuse_embeddings:
    input:
        hlca = f"{REF_GEOM}/hlca_mapping/hlca_latent.h5ad",
        luca = f"{REF_GEOM}/luca_mapping/luca_latent.h5ad"
    output:
        fused = f"{REF_GEOM}/fused_embedding.parquet",
        confidence = f"{REF_GEOM}/reference_confidence.parquet"
    threads: 4
    resources:
        mem_mb = 64000,
        runtime = 30
    log:
        f"{RUNS}/logs/reference/fuse_embeddings.log"
    script:
        "scripts/fuse_embeddings.py"


# =============================================================================
# Stage 2c: Merge Cell Types into snRNA (clean Snakemake dependency)
# =============================================================================

rule add_cell_type_labels:
    """
    Add dual-reference cell type labels to snRNA data.

    Reads separate HLCA and LuCA label parquets, adds both to h5ad:
    - cell_type: HLCA labels (primary, for spatial deconvolution)
    - luca_cell_type: LuCA labels (for ablation experiments)

    No compound labels - each column has single clean labels.
    """
    input:
        snrna = f"{PROCESSED}/snrna_qc_normalized_with_ensg.h5ad",
        hlca_labels = f"{REF_GEOM}/hlca_mapping/hlca_labels.parquet",
        luca_labels = f"{REF_GEOM}/luca_mapping/luca_labels.parquet"
    output:
        snrna_with_celltypes = f"{PROCESSED}/snrna_with_celltypes.h5ad"
    threads: 4
    resources:
        mem_mb = 180000,
        runtime = 60
    log:
        f"{RUNS}/logs/reference/add_cell_type_labels.log"
    shell:
        """
        python workflow/scripts/add_cell_type_labels.py \
            --snrna {input.snrna} \
            --hlca-labels {input.hlca_labels} \
            --luca-labels {input.luca_labels} \
            --output {output.snrna_with_celltypes} \
            2>&1 | tee {log}
        """


# =============================================================================
# Stage 2d: Validate Cell Type Markers (QC check before spatial deconv)
# =============================================================================

rule validate_markers:
    input:
        snrna = f"{PROCESSED}/snrna_with_celltypes.h5ad"
    output:
        report = f"{REF_GEOM}/marker_validation.json",
        enrichment = f"{REF_GEOM}/marker_validation.enrichment.csv"
    threads: 4
    resources:
        mem_mb = 64000,
        runtime = 30
    log:
        f"{RUNS}/logs/reference/validate_markers.log"
    shell:
        """
        python workflow/scripts/validate_markers.py \
            --adata {input.snrna} \
            --cell_type_col cell_type \
            --output {output.report} \
            2>&1 | tee {log}
        """


# =============================================================================
# Stage 3: Spatial Backend Benchmark (per-sample, then aggregate)
# NOTE: Requires snRNA with cell types AND marker validation
# =============================================================================

# Step 3a: Extract sample IDs from spatial data (checkpoint for dynamic samples)
checkpoint extract_spatial_samples:
    input:
        spatial = f"{PROCESSED}/spatial_merged.h5ad"
    output:
        manifest = f"{SPATIAL}/sample_manifest.json"
    resources:
        mem_mb = 256000,  # 256GB to load 35GB spatial file safely
        runtime = 30
    log:
        f"{RUNS}/logs/spatial/extract_samples.log"
    shell:
        """
        python workflow/scripts/extract_spatial_samples.py \
            --spatial {input.spatial} \
            --output {output.manifest} \
            --sample-col sample_id \
            2>&1 | tee {log}
        """


# Step 3b: Run Python backend on single sample with specific label source
rule spatial_backend_sample:
    input:
        snrna = f"{PROCESSED}/snrna_with_celltypes.h5ad",
        spatial = f"{PROCESSED}/spatial_merged.h5ad",
        marker_check = f"{REF_GEOM}/marker_validation.json",
        manifest = f"{SPATIAL}/sample_manifest.json",
        labels = f"{REF_GEOM}/hlca_mapping/hlca_labels.parquet"  # For LuCA, uses luca_cell_type col
    output:
        metrics = f"{SPATIAL}/{{label_source}}/{{backend}}/samples/{{sample}}/upstream_metrics.json",
        proportions = f"{SPATIAL}/{{label_source}}/{{backend}}/samples/{{sample}}/cell_type_proportions.parquet"
    wildcard_constraints:
        backend = "|".join(PYTHON_BACKENDS),
        label_source = "|".join(LABEL_SOURCES)
    threads: 8
    resources:
        mem_mb = 256000,  # 256GB for 35GB spatial + 19GB snRNA
        runtime = lambda wildcards: 720 if wildcards.backend in ["cell2location", "destvi"] else 240,  # 12 hours for slow backends
        slurm_partition = "gpu",
        gpu = 1,
        constraint = "h100"
    log:
        f"{RUNS}/logs/spatial/{{label_source}}/{{backend}}/{{sample}}.log"
    shell:
        """
        export TMPDIR="{DATA}/tmp"
        mkdir -p $TMPDIR
        python -m stagebridge.pipelines.run_spatial_benchmark \
            --snrna {input.snrna} \
            --spatial {input.spatial} \
            --output_dir {SPATIAL}/{wildcards.label_source}/{wildcards.backend}/samples/{wildcards.sample} \
            --backends {wildcards.backend} \
            --sample {wildcards.sample} \
            --sample-col sample_id \
            --label-source {wildcards.label_source} \
            2>&1 | tee {log}
        """


# Step 3b-R: Run R backend on single sample (requires r_deconv conda env)
rule spatial_r_backend_sample:
    input:
        snrna = f"{PROCESSED}/snrna_with_celltypes.h5ad",
        spatial = f"{PROCESSED}/spatial_merged.h5ad",
        marker_check = f"{REF_GEOM}/marker_validation.json",
        manifest = f"{SPATIAL}/sample_manifest.json",
        labels = f"{REF_GEOM}/hlca_mapping/hlca_labels.parquet"
    output:
        metrics = f"{SPATIAL}/{{label_source}}/{{backend}}/samples/{{sample}}/upstream_metrics.json",
        proportions = f"{SPATIAL}/{{label_source}}/{{backend}}/samples/{{sample}}/cell_type_proportions.parquet"
    wildcard_constraints:
        backend = "|".join(R_BACKENDS),
        label_source = "|".join(LABEL_SOURCES)
    threads: 8
    resources:
        mem_mb = 256000,
        runtime = 360,  # 6 hours for R backends
        slurm_partition = "gpu",
        gpu = 1,
        constraint = "h100"
    log:
        f"{RUNS}/logs/spatial/{{label_source}}/{{backend}}/{{sample}}.log"
    shell:
        """
        export R_EXECUTABLE="/scratch/chaunzt1/envs/r_deconv/lib/R/bin/Rscript"
        export R_LIBS_USER="/scratch/chaunzt1/envs/r_deconv/lib/R/library"
        export TMPDIR="{DATA}/tmp"
        mkdir -p $TMPDIR
        python -m stagebridge.pipelines.run_spatial_benchmark \
            --snrna {input.snrna} \
            --spatial {input.spatial} \
            --output_dir {SPATIAL}/{wildcards.label_source}/{wildcards.backend}/samples/{wildcards.sample} \
            --backends {wildcards.backend} \
            --sample {wildcards.sample} \
            --sample-col sample_id \
            --label-source {wildcards.label_source} \
            2>&1 | tee {log}
        """


def get_all_sample_outputs(wildcards):
    """Get all per-sample output files for a backend/label_source after checkpoint."""
    checkpoint_output = checkpoints.extract_spatial_samples.get(**wildcards).output.manifest
    import json
    with open(checkpoint_output) as f:
        manifest = json.load(f)
    samples = manifest["samples"]
    return expand(
        f"{SPATIAL}/{wildcards.label_source}/{wildcards.backend}/samples/{{sample}}/upstream_metrics.json",
        sample=samples
    )


# Step 3c: Aggregate per-sample results into backend summary (per label source)
rule spatial_backend_aggregate:
    input:
        sample_metrics = get_all_sample_outputs,
        manifest = f"{SPATIAL}/sample_manifest.json"
    output:
        metrics = f"{SPATIAL}/{{label_source}}/{{backend}}/upstream_metrics.json",
        proportions = f"{SPATIAL}/{{label_source}}/{{backend}}/cell_type_proportions.parquet"
    wildcard_constraints:
        backend = "|".join(SPATIAL_BACKENDS),
        label_source = "|".join(LABEL_SOURCES)
    threads: 2
    resources:
        mem_mb = 32000,
        runtime = 30
    log:
        f"{RUNS}/logs/spatial/{{label_source}}/{{backend}}_aggregate.log"
    shell:
        """
        python workflow/scripts/aggregate_spatial_samples.py \
            --backend {wildcards.backend} \
            --sample-dir {SPATIAL}/{wildcards.label_source}/{wildcards.backend}/samples \
            --output-dir {SPATIAL}/{wildcards.label_source}/{wildcards.backend} \
            --manifest {input.manifest} \
            2>&1 | tee {log}
        """


# Step 3d: Generate unified comparison figures per sample (all backends on same plot)
def get_all_backends_for_sample(wildcards):
    """Get all backend metrics for a single sample to trigger unified figure generation."""
    checkpoint_output = checkpoints.extract_spatial_samples.get(**wildcards).output.manifest
    import json
    with open(checkpoint_output) as f:
        manifest = json.load(f)
    samples = manifest["samples"]
    # Return all backend metrics for all samples (for this label_source)
    return expand(
        f"{SPATIAL}/{wildcards.label_source}/{{backend}}/samples/{{sample}}/upstream_metrics.json",
        backend=SPATIAL_BACKENDS,
        sample=samples
    )


rule spatial_unified_figures:
    input:
        backend_jsons = get_all_backends_for_sample,
        manifest = f"{SPATIAL}/sample_manifest.json"
    output:
        figures_done = f"{SPATIAL}/{{label_source}}/figures/unified_comparison/.done"
    wildcard_constraints:
        label_source = "|".join(LABEL_SOURCES)
    threads: 2
    resources:
        mem_mb = 16000,
        runtime = 60
    log:
        f"{RUNS}/logs/spatial/{{label_source}}/unified_figures.log"
    shell:
        """
        # Unified comparison: 2x2 grid (performance, radar, runtime, quality trade-offs)
        python scripts/create_unified_backend_comparison.py \
            --results-dir {SPATIAL} \
            --output-dir {SPATIAL}/{wildcards.label_source}/figures/unified_comparison \
            --label-source {wildcards.label_source} \
            2>&1 | tee {log}

        # Spatial comparison grid: cell types x backends spatial maps
        python scripts/create_backend_comparison_grid.py \
            --results-dir {SPATIAL} \
            --output-dir {SPATIAL}/{wildcards.label_source}/figures/backend_comparison \
            --label-source {wildcards.label_source} \
            2>&1 | tee -a {log}

        touch {output.figures_done}
        """


# Step 3f: Compare backends across label sources (HLCA vs LuCA ablation)
# This is a checkpoint because downstream rules need to read its output
checkpoint spatial_comparison:
    input:
        # All backends x all label sources
        expand(
            SPATIAL + "/{label_source}/{backend}/upstream_metrics.json",
            label_source=LABEL_SOURCES, backend=SPATIAL_BACKENDS
        ),
        # Unified comparison figures (all backends per sample)
        expand(
            SPATIAL + "/{label_source}/figures/unified_comparison/.done",
            label_source=LABEL_SOURCES
        )
    output:
        comparison = f"{SPATIAL}/backend_comparison.json",
        canonical = f"{SPATIAL}/canonical_backend.json",
        figure = f"{SPATIAL}/backend_comparison.png",
        label_ablation = f"{SPATIAL}/label_source_ablation.json"
    params:
        spatial_dir = SPATIAL,
        label_sources = LABEL_SOURCES,
        backends = SPATIAL_BACKENDS
    threads: 2
    resources:
        mem_mb = 16000,
        runtime = 15
    log:
        f"{RUNS}/logs/spatial/comparison.log"
    script:
        "scripts/compare_spatial_backends.py"


# =============================================================================
# Stage 3e: Create Canonical Backend Outputs (from existing benchmark results)
# =============================================================================
# Since we benchmark ALL samples with ALL backends, no need to rerun the winner.
# Just copy/symlink the winning backend's results to canonical/ directory.

rule canonical_backend_aggregate:
    input:
        # Depend on spatial_comparison which ensures all backends are done
        comparison = f"{SPATIAL}/backend_comparison.json",
        canonical_choice = f"{SPATIAL}/canonical_backend.json",
        manifest = f"{SPATIAL}/sample_manifest.json"
    output:
        proportions = f"{SPATIAL}/canonical/cell_type_proportions.parquet",
        metrics = f"{SPATIAL}/canonical/upstream_metrics.json"
    threads: 2
    resources:
        mem_mb = 32000,
        runtime = 30
    log:
        f"{RUNS}/logs/spatial/canonical_aggregate.log"
    shell:
        """
        # Read winning backend and label source
        BACKEND=$(python -c "import json; print(json.load(open('{input.canonical_choice}'))['backend'])")
        LABEL_SOURCE=$(python -c "import json; print(json.load(open('{input.canonical_choice}'))['label_source'])")

        echo "Canonical backend: $BACKEND ($LABEL_SOURCE)"
        echo "Copying results from existing benchmark (no rerun needed)"

        # Create canonical/samples/ by symlinking from winning backend's results
        mkdir -p {SPATIAL}/canonical/samples
        for sample_dir in {SPATIAL}/$LABEL_SOURCE/$BACKEND/samples/*/; do
            sample=$(basename "$sample_dir")
            ln -sfn "$(realpath $sample_dir)" "{SPATIAL}/canonical/samples/$sample"
        done

        # Aggregate using existing script
        python workflow/scripts/aggregate_spatial_samples.py \
            --backend $BACKEND \
            --sample-dir {SPATIAL}/canonical/samples \
            --output-dir {SPATIAL}/canonical \
            --manifest {input.manifest} \
            2>&1 | tee {log}
        """


# =============================================================================
# Stage 3f: Clonal Pattern Extraction (CNV-based evolution patterns)
# =============================================================================
# Extracts clonal evolution patterns (1a, 1b, 2) from spatial data using
# inferCNVpy. Required for H3 hypothesis validation.
#
# Patterns:
#   1a: Direct lineage (shared clones across stages)
#   1b: Branched evolution (shared ancestor, divergent clones)
#   2:  Independent origins (no shared clones)

rule clonal_extraction:
    input:
        # Use snRNA data (single-cell resolution, has cell types from HLCA mapping)
        # CNV inference needs single-cell resolution for accurate clone identification
        snrna = f"{PROCESSED}/snrna_with_celltypes.h5ad",
        # Ensure cell type labels are validated first
        marker_check = f"{REF_GEOM}/marker_validation.json"
    output:
        patterns = f"{CLONAL}/clonal_patterns.json",
        details = f"{CLONAL}/clonal_analysis_details.csv",
        cnv_profiles = f"{CLONAL}/epithelial_cnv.h5ad"
    params:
        clonal_dir = CLONAL
    threads: 8
    resources:
        mem_mb = 256000,  # 256GB for full snRNA data
        runtime = 360,    # 6 hours (CNV inference is slow)
        slurm_partition = "gpu",
        gpu = 1
    log:
        f"{RUNS}/logs/clonal/extraction.log"
    shell:
        """
        python -m stagebridge.pipelines.run_clonal_extraction \
            --spatial-h5ad {input.snrna} \
            --output-dir {params.clonal_dir} \
            --patient-key donor_id \
            --stage-key stage \
            --cell-type-key cell_type \
            2>&1 | tee {log}
        """


# =============================================================================
# Stage 3g: LIANA L-R Analysis (Biological Validation for H1.2)
# =============================================================================
# Validates that IL1B-IL1R1 is a top L-R pair in the dataset.
# Key evidence for H1.2: "IL1B-high proinflammatory niches increase transition
# probability for alveolar progenitors"

LIANA = f"{RUNS}/biological_validation/liana"

rule liana_analysis:
    input:
        snrna = f"{PROCESSED}/snrna_with_celltypes.h5ad",
        marker_check = f"{REF_GEOM}/marker_validation.json"  # Ensure cell types validated
    output:
        full = f"{LIANA}/lr_interactions_full.parquet",
        top100 = f"{LIANA}/lr_interactions_top100.parquet",
        il1b = f"{LIANA}/lr_il1b_il1r1.parquet",
        summary = f"{LIANA}/liana_summary.json"
    params:
        output_dir = LIANA,
        n_perms = 100,
        expr_prop = 0.05  # Lower threshold to catch rare cell type interactions
    threads: 8
    resources:
        mem_mb = 256000,  # 256GB for 800K cells
        runtime = 180,    # 3 hours
        slurm_partition = "gpu",
        gpu = 1
    log:
        f"{RUNS}/logs/biological_validation/liana.log"
    shell:
        """
        python scripts/run_liana_analysis.py \
            --snrna {input.snrna} \
            --output-dir {params.output_dir} \
            --n-perms {params.n_perms} \
            --expr-prop {params.expr_prop} \
            2>&1 | tee {log}
        """


# =============================================================================
# Stage 4: Complete Data Preparation
# =============================================================================

rule data_preparation:
    input:
        fused = f"{REF_GEOM}/fused_embedding.parquet",
        canonical_props = f"{SPATIAL}/canonical/cell_type_proportions.parquet",  # From canonical_backend_aggregate
        canonical_metrics = f"{SPATIAL}/canonical/upstream_metrics.json",
        snrna = f"{PROCESSED}/snrna_with_celltypes.h5ad",
        spatial = f"{PROCESSED}/spatial_merged.h5ad",
        wes = f"{PROCESSED}/wes_features.parquet",
        clonal = f"{CLONAL}/clonal_patterns.json",  # From clonal_extraction
        # HLCA and LuCA deconvolution for spatial embedding composition
        hlca_deconv = f"{SPATIAL}/hlca/destvi/cell_type_proportions.parquet",
        luca_deconv = f"{SPATIAL}/luca/destvi/cell_type_proportions.parquet"
    output:
        cells = f"{CANONICAL}/cells.parquet",
        neighborhoods = f"{CANONICAL}/neighborhoods.parquet",
        splits = f"{CANONICAL}/split_manifest.json",
        manifest = f"{CANONICAL}/data_manifest.json"
    params:
        spatial_dir = SPATIAL,
        canonical_dir = CANONICAL,
        hlca_deconv_dir = f"{SPATIAL}/hlca/destvi",
        luca_deconv_dir = f"{SPATIAL}/luca/destvi"
    threads: 16
    resources:
        mem_mb = 256000,
        runtime = 120,  # 2 hours
        slurm_partition = "gpu",
        gpu = 1
    log:
        f"{RUNS}/logs/data_preparation.log"
    shell:
        """
        python -m stagebridge.pipelines.complete_data_prep \
            --snrna {input.snrna} \
            --spatial {input.spatial} \
            --wes {input.wes} \
            --spatial_backend_dir {params.spatial_dir}/canonical \
            --reference_geometry {REF_GEOM} \
            --output_dir {params.canonical_dir} \
            --clonal_patterns {input.clonal} \
            --hlca_deconv_dir {params.hlca_deconv_dir} \
            --luca_deconv_dir {params.luca_deconv_dir} \
            2>&1 | tee {log}
        """


# =============================================================================
# Stage 4b: Validate Splits (CRITICAL - prevents donor leakage)
# =============================================================================

rule validate_splits:
    input:
        cells = f"{CANONICAL}/cells.parquet",
        splits = f"{CANONICAL}/split_manifest.json"
    output:
        report = f"{CANONICAL}/leakage_validation.json"
    threads: 1
    resources:
        mem_mb = 16000,
        runtime = 10
    log:
        f"{RUNS}/logs/validate_splits.log"
    shell:
        """
        python workflow/scripts/validate_splits.py \
            --cells {input.cells} \
            --splits {input.splits} \
            --output {output.report} \
            2>&1 | tee {log}
        """


# =============================================================================
# Stage 5a: Generate Semi-Synthetic Benchmark (with ground truth)
# =============================================================================

rule semi_synthetic_benchmark:
    input:
        manifest = f"{CANONICAL}/data_manifest.json",
        leakage_check = f"{CANONICAL}/leakage_validation.json"  # Require clean splits
    output:
        benchmark = f"{CANONICAL}/benchmark/semi_synthetic.pt",
        ground_truth = f"{CANONICAL}/benchmark/ground_truth.json"
    threads: 4
    resources:
        mem_mb = 64000,
        runtime = 30
    log:
        f"{RUNS}/logs/semi_synthetic_benchmark.log"
    script:
        "scripts/generate_semi_synthetic.py"


# =============================================================================
# Stage 5b: Hyperparameter Optimization (Optuna)
# =============================================================================

rule hpo:
    input:
        cells = f"{CANONICAL}/cells.parquet",
        neighborhoods = f"{CANONICAL}/neighborhoods.parquet",
        splits = f"{CANONICAL}/split_manifest.json",
        benchmark = f"{CANONICAL}/benchmark/semi_synthetic.pt",
        leakage_check = f"{CANONICAL}/leakage_validation.json"  # Require clean splits
    output:
        best_params = f"{TRAINING}/hpo/best_params.json",
        hpo_history = f"{TRAINING}/hpo/optimization_history.json"
    params:
        n_trials = 30,
        canonical_dir = CANONICAL,
        hpo_dir = f"{TRAINING}/hpo"
    threads: 8
    resources:
        mem_mb = 128000,
        runtime = 480,  # 8 hours for 30 trials
        slurm_partition = "gpu",
        gpu = 1
    log:
        f"{RUNS}/logs/hpo.log"
    shell:
        """
        python -m stagebridge.pipelines.run_hpo \
            --data_dir {params.canonical_dir} \
            --output_dir {params.hpo_dir} \
            --n_trials {params.n_trials} \
            2>&1 | tee {log}
        """


# =============================================================================
# Stage 5c: Full Model Training (Two-Stage: SSL + Transition)
# =============================================================================
#
# 5-fold cross-validation × 3 seeds = 15 training runs
# Each run: SSL Pretraining + Transition Model
#
# Stage 1: SSL Pretraining (~4-6 hours with 4 GPUs)
#   - Objective: Masked receiver reconstruction from niche context
#   - Learn niche-aware representations
#
# Stage 2: Transition Model (~2-3 hours with 4 GPUs)
#   - Objective: Predict state transitions (flow field)
#   - Fine-tune on stage transition dynamics
#

rule training:
    input:
        cells = f"{CANONICAL}/cells.parquet",
        neighborhoods = f"{CANONICAL}/neighborhoods.parquet",
        splits = f"{CANONICAL}/split_manifest.json",
        benchmark = f"{CANONICAL}/benchmark/semi_synthetic.pt",
        hpo_params = f"{TRAINING}/hpo/best_params.json",
        leakage_check = f"{CANONICAL}/leakage_validation.json"  # Require clean splits
    output:
        checkpoint = f"{TRAINING}/fold{{fold}}_seed{{seed}}/checkpoints/final_checkpoint.pt",
        best = f"{TRAINING}/fold{{fold}}_seed{{seed}}/checkpoints/best_checkpoint.pt",
        ssl_checkpoint = f"{TRAINING}/fold{{fold}}_seed{{seed}}/checkpoints/ssl_pretrained.pt",
        metrics = f"{TRAINING}/fold{{fold}}_seed{{seed}}/metrics/training_metrics.csv",
        config = f"{TRAINING}/fold{{fold}}_seed{{seed}}/config.json",
        results = f"{TRAINING}/fold{{fold}}_seed{{seed}}/results.json"
    wildcard_constraints:
        fold = "[0-4]",
        seed = "[0-9]+"
    params:
        ssl_epochs = 100,
        transition_epochs = 50,
        canonical_dir = CANONICAL,
        training_dir = TRAINING
    threads: 8
    resources:
        mem_mb = 256000,  # 256GB for 1.4M cells + neighborhoods + ring compositions
        runtime = 480,    # 8 hours (single GPU, no DDP overhead)
        slurm_partition = "gpu",
        gpu = 1,
        constraint = "h100"
    log:
        f"{RUNS}/logs/training/fold{{fold}}_seed{{seed}}.log"
    shell:
        """
        echo "=============================================="
        echo "StageBridge V1 Training"
        echo "  Fold: {wildcards.fold}/5"
        echo "  Seed: {wildcards.seed}"
        echo "  Stage 1: SSL Pretraining ({params.ssl_epochs} epochs)"
        echo "  Stage 2: Transition Model ({params.transition_epochs} epochs)"
        echo "  GPU: 1x H100 (single-process, no DDP overhead)"
        echo "  HPO params: {input.hpo_params}"
        echo "=============================================="

        # Single GPU via torchrun with nproc=1 (no DDP overhead, keeps same CLI)
        torchrun \
            --nproc_per_node=1 \
            --master_port=$((29500 + {wildcards.fold} * 10 + {wildcards.seed} % 10)) \
            -m stagebridge.pipelines.run_v1_ddp \
            --data_dir {params.canonical_dir} \
            --output_dir {params.training_dir}/fold{wildcards.fold}_seed{wildcards.seed} \
            --validation_fold {wildcards.fold} \
            --seed {wildcards.seed} \
            --ssl_epochs {params.ssl_epochs} \
            --transition_epochs {params.transition_epochs} \
            --batch_size 256 \
            --checkpoint_every 10 \
            --hpo_params {input.hpo_params} \
            --use_best_hparams \
            2>&1 | tee {log}
        """


# =============================================================================
# Stage 5c-ablation: Training with Frozen Encoder (SSL transfer test)
# =============================================================================
# Tests whether SSL representations transfer directly to transition task
# without fine-tuning. Compares to main training to validate SSL quality.

rule training_frozen:
    input:
        cells = f"{CANONICAL}/cells.parquet",
        neighborhoods = f"{CANONICAL}/neighborhoods.parquet",
        splits = f"{CANONICAL}/split_manifest.json",
        benchmark = f"{CANONICAL}/benchmark/semi_synthetic.pt",
        hpo_params = f"{TRAINING}/hpo/best_params.json",
        leakage_check = f"{CANONICAL}/leakage_validation.json"
    output:
        checkpoint = f"{TRAINING}/frozen/fold{{fold}}_seed{{seed}}/checkpoints/final_checkpoint.pt",
        best = f"{TRAINING}/frozen/fold{{fold}}_seed{{seed}}/checkpoints/best_checkpoint.pt",
        ssl_checkpoint = f"{TRAINING}/frozen/fold{{fold}}_seed{{seed}}/checkpoints/ssl_pretrained.pt",
        metrics = f"{TRAINING}/frozen/fold{{fold}}_seed{{seed}}/metrics/training_metrics.csv",
        config = f"{TRAINING}/frozen/fold{{fold}}_seed{{seed}}/config.json",
        results = f"{TRAINING}/frozen/fold{{fold}}_seed{{seed}}/results.json"
    wildcard_constraints:
        fold = "[0-4]",
        seed = "[0-9]+"
    params:
        ssl_epochs = 100,
        transition_epochs = 50,
        canonical_dir = CANONICAL,
        training_dir = TRAINING
    threads: 8
    resources:
        mem_mb = 256000,  # 256GB for 1.4M cells + neighborhoods + ring compositions
        runtime = 480,
        slurm_partition = "gpu",
        gpu = 1,
        constraint = "h100"
    log:
        f"{RUNS}/logs/training_frozen/fold{{fold}}_seed{{seed}}.log"
    shell:
        """
        echo "=============================================="
        echo "StageBridge V1 Training (FROZEN ENCODER ABLATION)"
        echo "  Fold: {wildcards.fold}/5"
        echo "  Seed: {wildcards.seed}"
        echo "  Stage 1: SSL Pretraining ({params.ssl_epochs} epochs)"
        echo "  Stage 2: Transition Model ({params.transition_epochs} epochs) - FROZEN"
        echo "  GPU: 1x H100 (single-process, no DDP overhead)"
        echo "  Purpose: Test SSL representation transfer quality"
        echo "=============================================="

        # Single GPU via torchrun with nproc=1 (no DDP overhead, keeps same CLI)
        torchrun \
            --nproc_per_node=1 \
            --master_port=$((29600 + {wildcards.fold} * 10 + {wildcards.seed} % 10)) \
            -m stagebridge.pipelines.run_v1_ddp \
            --data_dir {params.canonical_dir} \
            --output_dir {params.training_dir}/frozen/fold{wildcards.fold}_seed{wildcards.seed} \
            --validation_fold {wildcards.fold} \
            --seed {wildcards.seed} \
            --ssl_epochs {params.ssl_epochs} \
            --transition_epochs {params.transition_epochs} \
            --batch_size 256 \
            --checkpoint_every 10 \
            --hpo_params {input.hpo_params} \
            --use_best_hparams \
            --freeze_encoder \
            2>&1 | tee {log}
        """


# =============================================================================
# Training: Run both fine-tuned and frozen in parallel
# =============================================================================

rule training_all:
    """Run both fine-tuned and frozen encoder training in parallel for efficiency."""
    input:
        # Fine-tuned (15 runs: 5 folds × 3 seeds)
        finetuned = expand(
            f"{TRAINING}/fold{{fold}}_seed{{seed}}/results.json",
            fold=FOLDS, seed=SEEDS
        ),
        # Frozen encoder ablation (15 runs: 5 folds × 3 seeds)
        frozen = expand(
            f"{TRAINING}/frozen/fold{{fold}}_seed{{seed}}/results.json",
            fold=FOLDS, seed=SEEDS
        )
    output:
        touch(f"{TRAINING}/training_all.done")


