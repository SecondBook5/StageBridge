    params:
        fold=lambda w: w.fold,
        run_dir=lambda w: f"{OUTPUT_DIR}/inference/full/fold_{w.fold}",
    resources:
        gpu=1,
        runtime=240,  # 4 hours
        mem_mb=32000,
    shell:
        """
        python -m stagebridge.pipelines.infer \
            --checkpoint {input.checkpoint} \
            --data-dir {DATA_DIR} \
            --output-dir {params.run_dir} \
            --fold-idx {params.fold}
        """


# =============================================================================
# EVALUATION
# =============================================================================

rule evaluate_full:
    """Evaluate full model predictions."""
    input:
        predictions=f"{OUTPUT_DIR}/inference/full/fold_{{fold}}/predictions.parquet",
        neighborhoods=f"{DATA_DIR}/neighborhoods.parquet",
    output:
        evaluation=f"{OUTPUT_DIR}/evaluation/full/fold_{{fold}}/evaluation.json",
    params:
        fold=lambda w: w.fold,
        run_dir=lambda w: f"{OUTPUT_DIR}/evaluation/full/fold_{w.fold}",
    resources:
        runtime=120,  # 2 hours
        mem_mb=16000,
    shell:
        """
        python -m stagebridge.evaluation.metrics \
            --predictions {input.predictions} \
            --reference {DATA_DIR}/neighborhoods.parquet \
            --output-dir {params.run_dir} \
            --fold-idx {params.fold}
        """


# =============================================================================
# COMPARISON REPORT
# =============================================================================

rule comparison_report:
    """Generate final comparison report aggregating all results."""
    input:
        full_evals=expand(f"{OUTPUT_DIR}/evaluation/full/fold_{{fold}}/evaluation.json", fold=FOLDS),
        baseline_results=expand(f"{OUTPUT_DIR}/baselines/{{baseline}}/fold_{{fold}}/baseline_{{baseline}}.json",
                                baseline=BASELINES, fold=FOLDS),
        ablation_results=expand(f"{OUTPUT_DIR}/ablations/{{ablation}}/fold_{{fold}}/ablation_{{ablation}}.json",
                                ablation=ABLATIONS, fold=FOLDS),
    output:
        report=f"{RESULTS_DIR}/comparison_report.json",
    params:
        output_dir=OUTPUT_DIR,
        results_dir=RESULTS_DIR,
    resources:
        runtime=30,
        mem_mb=4000,
    run:
        import json
        from pathlib import Path
        from datetime import datetime

        Path(params.results_dir).mkdir(parents=True, exist_ok=True)

        report = {
            "created_at": datetime.now().isoformat(),
            "n_folds": N_FOLDS,
            "seed": SEED,
            "paths": {
                "data_dir": DATA_DIR,
                "output_dir": OUTPUT_DIR,
                "hlca_dir": HLCA_DIR,
                "luca_dir": LUCA_DIR,
            },
            "full_model": {},
            "baselines": {},
            "ablations": {},
        }

        # Aggregate full model results
        full_metrics = []
        for f in input.full_evals:
            try:
                with open(f) as fp:
                    full_metrics.append(json.load(fp))
            except Exception as e:
                print(f"Warning: Could not load {f}: {e}")

        if full_metrics:
            report["full_model"] = {
                "mean_w2": sum(m.get("wasserstein_distance", 0) for m in full_metrics) / len(full_metrics),
                "mean_mmd": sum(m.get("mmd", 0) for m in full_metrics) / len(full_metrics),
                "mean_displacement": sum(m.get("mean_displacement", 0) for m in full_metrics) / len(full_metrics),
                "n_folds": len(full_metrics),
            }

        # Aggregate baseline results
        for baseline in BASELINES:
            baseline_files = [f for f in input.baseline_results if baseline in f]
            metrics = []
            for f in baseline_files:
                try:
                    with open(f) as fp:
                        metrics.append(json.load(fp))
                except Exception as e:
                    print(f"Warning: Could not load {f}: {e}")
            if metrics:
                report["baselines"][baseline] = {
                    "mean_val_loss": sum(m.get("metrics", {}).get("val_loss", 0) for m in metrics) / len(metrics),
                    "n_parameters": metrics[0].get("n_parameters", "unknown"),
                    "n_folds": len(metrics),
                }

        # Aggregate ablation results
        for ablation in ABLATIONS:
            ablation_files = [f for f in input.ablation_results if f"ablation_{ablation}" in f]
            metrics = []
            for f in ablation_files:
                try:
                    with open(f) as fp:
                        metrics.append(json.load(fp))
                except Exception as e:
                    print(f"Warning: Could not load {f}: {e}")
            if metrics:
                report["ablations"][ablation] = {
                    "mean_val_loss": sum(m.get("metrics", {}).get("val_loss", 0) for m in metrics) / len(metrics),
                    "n_folds": len(metrics),
                }

        # Compute deltas vs full
        full_loss = report["full_model"].get("mean_w2", 0) if report["full_model"] else 0
        for baseline, data in report["baselines"].items():
            data["delta_vs_full"] = data["mean_val_loss"] - full_loss
        for ablation, data in report["ablations"].items():
            data["delta_vs_full"] = data["mean_val_loss"] - full_loss

        with open(output.report, "w") as f:
            json.dump(report, f, indent=2)

        print(f"Comparison report saved to {output.report}")


