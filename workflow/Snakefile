rule validate_data:
    """Validate data directory contract."""
    input:
        cells=f"{DATA_DIR}/cells.parquet",
        neighborhoods=f"{DATA_DIR}/neighborhoods.parquet",
        manifest=f"{DATA_DIR}/split_manifest.json",
    output:
        touch(f"{OUTPUT_DIR}/.data_validated")
    resources:
        mem_mb=256000,
        runtime=60,
        slurm_partition="gpu",
    shell:
        """
        python -c "
from stagebridge.contracts import validate_contract
validate_contract('{DATA_DIR}')
print('Data contract validated successfully')
"
        """


# =============================================================================
# HYPERPARAMETER OPTIMIZATION
# =============================================================================

rule hpo:
    """Hyperparameter optimization using Optuna.

    Searches over model architecture and training hyperparameters.
    Outputs best_params.json which can be used by subsequent training runs.
    """
    input:
        validated=f"{OUTPUT_DIR}/.data_validated",
        neighborhoods=f"{DATA_DIR}/neighborhoods.parquet",
    output:
        best_params=f"{OUTPUT_DIR}/hpo/best_params.json",
        history=f"{OUTPUT_DIR}/hpo/optimization_history.json",
    params:
        hpo_dir=f"{OUTPUT_DIR}/hpo",
        n_trials=config.get("hpo", {}).get("n_trials", 30),
        n_epochs=config.get("hpo", {}).get("n_epochs_per_trial", 10),
        batch_size=config["trainer"]["batch_size"],
    resources:
        mem_mb=256000,
        runtime=1440,  # 24 hours (resumable if timeout)
        slurm_partition="gpu",
        gpu=1,
    shell:
        """
        python -m stagebridge.pipelines.run_hpo \
            --data-dir {DATA_DIR} \
            --output-dir {params.hpo_dir} \
            --n-trials {params.n_trials} \
            --n-epochs {params.n_epochs} \
            --batch-size {params.batch_size} \
            --seed {SEED} \
            --storage sqlite:///{params.hpo_dir}/optuna.db \
            --study-name stagebridge_hpo
        """


# =============================================================================
# TRAINING: FULL MODEL
# =============================================================================

rule train_full:
    """Train full StageBridge model with two-stage training.

    STAGE 1 (SSL): Masked receiver reconstruction
    STAGE 2 (Transition): OT-CFM flow matching

    GW fusion is enabled by default for the full model.
    Uses best hyperparameters from HPO.
    Runs for each fold x seed combination.
    """
    input:
        validated=f"{OUTPUT_DIR}/.data_validated",
        neighborhoods=f"{DATA_DIR}/neighborhoods.parquet",
        hpo_params=f"{OUTPUT_DIR}/hpo/best_params.json",
    output:
        summary=f"{OUTPUT_DIR}/full/fold_{{fold}}/seed_{{seed}}/training_summary.json",
        checkpoint=f"{OUTPUT_DIR}/full/fold_{{fold}}/seed_{{seed}}/checkpoints/best_checkpoint.pt",
    params:
        fold=lambda w: w.fold,
        seed=lambda w: w.seed,
        run_dir=lambda w: f"{OUTPUT_DIR}/full/fold_{w.fold}/seed_{w.seed}",
        ssl_epochs=config["trainer"]["ssl_epochs"],
        transition_epochs=config["trainer"]["transition_epochs"],
        batch_size=config["trainer"]["batch_size"],
    resources:
        mem_mb=256000,
        runtime=2880,  # 48 hours
        slurm_partition="gpu",
        gpu=1,
    shell:
        """
        python -m stagebridge.training.trainer \
            --data-dir {DATA_DIR} \
            --output-dir {params.run_dir} \
            --fold-idx {params.fold} \
            --seed {params.seed} \
            --ssl-epochs {params.ssl_epochs} \
            --transition-epochs {params.transition_epochs} \
            --batch-size {params.batch_size} \
            --hpo-params {input.hpo_params}
        """


# =============================================================================
# TRAINING: BASELINES
# =============================================================================

rule train_baseline:
    """Train a baseline model for comparison.

    Runs for each baseline x fold x seed combination.
    """
    input:
        validated=f"{OUTPUT_DIR}/.data_validated",
        neighborhoods=f"{DATA_DIR}/neighborhoods.parquet",
    output:
        result=f"{OUTPUT_DIR}/baselines/{{baseline}}/fold_{{fold}}/seed_{{seed}}/baseline_{{baseline}}.json",
        checkpoint=f"{OUTPUT_DIR}/baselines/{{baseline}}/fold_{{fold}}/seed_{{seed}}/checkpoints/{{baseline}}_final.pt",
    params:
        baseline=lambda w: w.baseline,
        fold=lambda w: w.fold,
        seed=lambda w: w.seed,
        run_dir=lambda w: f"{OUTPUT_DIR}/baselines/{w.baseline}/fold_{w.fold}/seed_{w.seed}",
    resources:
        mem_mb=256000,
        runtime=720,  # 12 hours
        slurm_partition="gpu",
        gpu=1,
    shell:
        """
        python -m stagebridge.baselines.train \
            --baseline {params.baseline} \
            --data-dir {DATA_DIR} \
            --output-dir {params.run_dir} \
            --fold-idx {params.fold} \
            --seed {params.seed}
        """


# =============================================================================
# ABLATIONS
# =============================================================================

rule run_ablation:
    """Run an ablation experiment.

    Depends on train_full completing first so we can compare against the full model.
    Uses the same HPO params as train_full for fair comparison.
    Each fold x seed ablation waits only for that fold x seed full model.

    For frozen_encoder ablation, passes the pretrained checkpoint path.
    """
    input:
        validated=f"{OUTPUT_DIR}/.data_validated",
        neighborhoods=f"{DATA_DIR}/neighborhoods.parquet",
        hpo_params=f"{OUTPUT_DIR}/hpo/best_params.json",
        # Wait for this fold x seed full model to complete before running ablation
        full_model=f"{OUTPUT_DIR}/full/fold_{{fold}}/seed_{{seed}}/training_summary.json",
        # Checkpoint needed for frozen_encoder ablation
        full_checkpoint=f"{OUTPUT_DIR}/full/fold_{{fold}}/seed_{{seed}}/checkpoints/best_checkpoint.pt",
    output:
        result=f"{OUTPUT_DIR}/ablations/{{ablation}}/fold_{{fold}}/seed_{{seed}}/ablation_{{ablation}}.json",
        checkpoint=f"{OUTPUT_DIR}/ablations/{{ablation}}/fold_{{fold}}/seed_{{seed}}/checkpoints/best_checkpoint.pt",
    params:
        ablation=lambda w: w.ablation,
        fold=lambda w: w.fold,
        seed=lambda w: w.seed,
        run_dir=lambda w: f"{OUTPUT_DIR}/ablations/{w.ablation}/fold_{w.fold}/seed_{w.seed}",
        # Pass checkpoint arg only for frozen_encoder
        checkpoint_arg=lambda w: f"--pretrained-checkpoint {OUTPUT_DIR}/full/fold_{w.fold}/seed_{w.seed}/checkpoints/best_checkpoint.pt" if w.ablation == "frozen_encoder" else "",
    resources:
        mem_mb=256000,
        runtime=1440,  # 24 hours
        slurm_partition="gpu",
        gpu=1,
    shell:
        """
        python -m stagebridge.evaluation.ablation \
            --ablation {params.ablation} \
            --data-dir {DATA_DIR} \
            --output-dir {params.run_dir} \
            --fold-idx {params.fold} \
            --seed {params.seed} \
            --hpo-params {input.hpo_params} \
            {params.checkpoint_arg}
        """


# =============================================================================
# INFERENCE
# =============================================================================

rule infer_full:
    """Run inference with full model.

    Runs per fold x seed. Predictions are later aggregated for evaluation.
    """
    input:
        checkpoint=f"{OUTPUT_DIR}/full/fold_{{fold}}/seed_{{seed}}/checkpoints/best_checkpoint.pt",
        neighborhoods=f"{DATA_DIR}/neighborhoods.parquet",
    output:
        predictions=f"{OUTPUT_DIR}/inference/full/fold_{{fold}}/seed_{{seed}}/predictions.parquet",
    params:
        fold=lambda w: w.fold,
        seed=lambda w: w.seed,
        run_dir=lambda w: f"{OUTPUT_DIR}/inference/full/fold_{w.fold}/seed_{w.seed}",
    resources:
        mem_mb=256000,
        runtime=240,  # 4 hours
        slurm_partition="gpu",
        gpu=1,
    shell:
        """
        python -m stagebridge.pipelines.infer \
            --checkpoint {input.checkpoint} \
            --data-dir {DATA_DIR} \
            --output-dir {params.run_dir} \
            --fold-idx {params.fold}
        """


# =============================================================================
# EVALUATION
# =============================================================================

rule evaluate_full:
    """Evaluate full model predictions on held-out test set.

    Aggregates predictions across seeds for each fold to compute mean +/- std.
    """
    input:
        # All seeds for this fold
        predictions=expand(f"{OUTPUT_DIR}/inference/full/fold_{{fold}}/seed_{{seed}}/predictions.parquet",
                          seed=SEEDS, allow_missing=True),
        neighborhoods=f"{DATA_DIR}/neighborhoods.parquet",
    output:
        evaluation=f"{OUTPUT_DIR}/evaluation/full/fold_{{fold}}/evaluation.json",
    params:
        fold=lambda w: w.fold,
        run_dir=lambda w: f"{OUTPUT_DIR}/evaluation/full/fold_{w.fold}",
        seeds=SEEDS,
    resources:
        mem_mb=256000,
        runtime=120,  # 2 hours
        slurm_partition="gpu",
        gpu=1,
    shell:
        """
        python -m stagebridge.evaluation.evaluate \
            --predictions {input.predictions} \
            --data-dir {DATA_DIR} \
            --output-dir {params.run_dir} \
            --fold-idx {params.fold} \
            --aggregate-seeds
        """


# =============================================================================
# COMPARISON REPORT
# =============================================================================

rule comparison_report:
    """Generate final comparison report aggregating all results across folds and seeds."""
    input:
        full_evals=expand(f"{OUTPUT_DIR}/evaluation/full/fold_{{fold}}/evaluation.json", fold=FOLDS),
        baseline_results=expand(f"{OUTPUT_DIR}/baselines/{{baseline}}/fold_{{fold}}/seed_{{seed}}/baseline_{{baseline}}.json",
                                baseline=BASELINES, fold=FOLDS, seed=SEEDS),
        ablation_results=expand(f"{OUTPUT_DIR}/ablations/{{ablation}}/fold_{{fold}}/seed_{{seed}}/ablation_{{ablation}}.json",
                                ablation=ABLATIONS, fold=FOLDS, seed=SEEDS),
    output:
        report=f"{RESULTS_DIR}/comparison_report.json",
    params:
        output_dir=OUTPUT_DIR,
        results_dir=RESULTS_DIR,
        seeds=SEEDS,
    resources:
        mem_mb=128000,
        runtime=30,
        slurm_partition="cpu",
    run:
        import json
        from pathlib import Path
        from datetime import datetime

        Path(params.results_dir).mkdir(parents=True, exist_ok=True)

        report = {
            "created_at": datetime.now().isoformat(),
            "n_folds": N_FOLDS,
            "seed": SEED,
            "paths": {
                "data_dir": DATA_DIR,
                "output_dir": OUTPUT_DIR,
                "hlca_dir": HLCA_DIR,
                "luca_dir": LUCA_DIR,
            },
            "full_model": {},
            "baselines": {},
            "ablations": {},
        }

        # Aggregate full model results
        full_metrics = []
        for f in input.full_evals:
            try:
                with open(f) as fp:
                    full_metrics.append(json.load(fp))
            except Exception as e:
                print(f"Warning: Could not load {f}: {e}")

        if full_metrics:
            report["full_model"] = {
                "mean_w2": sum(m.get("wasserstein_distance", 0) for m in full_metrics) / len(full_metrics),
                "mean_mmd": sum(m.get("mmd", 0) for m in full_metrics) / len(full_metrics),
                "mean_displacement": sum(m.get("mean_displacement", 0) for m in full_metrics) / len(full_metrics),
                "n_folds": len(full_metrics),
            }

        # Aggregate baseline results
        for baseline in BASELINES:
            baseline_files = [f for f in input.baseline_results if baseline in f]
            metrics = []
            for f in baseline_files:
                try:
                    with open(f) as fp:
                        metrics.append(json.load(fp))
                except Exception as e:
                    print(f"Warning: Could not load {f}: {e}")
            if metrics:
                report["baselines"][baseline] = {
                    "mean_val_loss": sum(m.get("metrics", {}).get("val_loss", 0) for m in metrics) / len(metrics),
                    "n_parameters": metrics[0].get("n_parameters", "unknown"),
                    "n_folds": len(metrics),
                }

        # Aggregate ablation results
        for ablation in ABLATIONS:
            ablation_files = [f for f in input.ablation_results if f"ablation_{ablation}" in f]
            metrics = []
            for f in ablation_files:
                try:
                    with open(f) as fp:
                        metrics.append(json.load(fp))
                except Exception as e:
                    print(f"Warning: Could not load {f}: {e}")
            if metrics:
                report["ablations"][ablation] = {
                    "mean_val_loss": sum(m.get("metrics", {}).get("val_loss", 0) for m in metrics) / len(metrics),
                    "n_folds": len(metrics),
                }

        # Compute deltas vs full
        full_loss = report["full_model"].get("mean_w2", 0) if report["full_model"] else 0
        for baseline, data in report["baselines"].items():
            data["delta_vs_full"] = data["mean_val_loss"] - full_loss
        for ablation, data in report["ablations"].items():
            data["delta_vs_full"] = data["mean_val_loss"] - full_loss

        with open(output.report, "w") as f:
            json.dump(report, f, indent=2)

        print(f"Comparison report saved to {output.report}")


# =============================================================================
# FIGURE GENERATION
# =============================================================================

rule run_inference_for_figures:
    """Run inference to get embeddings, predictions, attention for figures.

    Uses fold 0, seed 0 (first seed) as representative for figures.
    """
    input:
        checkpoint=f"{OUTPUT_DIR}/full/fold_0/seed_{SEEDS[0]}/checkpoints/best_checkpoint.pt",
        neighborhoods=f"{DATA_DIR}/neighborhoods.parquet",
    output:
        embeddings=f"{OUTPUT_DIR}/inference/figure_data/embeddings.parquet",
        predictions=f"{OUTPUT_DIR}/inference/figure_data/predictions.parquet",
        attention=f"{OUTPUT_DIR}/inference/figure_data/attention_weights.npz",
    params:
        run_dir=f"{OUTPUT_DIR}/inference/figure_data",
    resources:
        mem_mb=256000,
        runtime=240,  # 4 hours
        slurm_partition="gpu",
        gpu=1,
    shell:
        """
        python -m stagebridge.pipelines.infer \
            --checkpoint {input.checkpoint} \
            --data-dir {DATA_DIR} \
            --output-dir {params.run_dir} \
            --fold-idx 0 \
            --save-embeddings \
            --save-attention
        """


