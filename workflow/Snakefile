# =============================================================================
# StageBridge V1 Publication Pipeline - Snakemake Workflow
# =============================================================================
#
# A complete, reproducible pipeline for StageBridge V1.
#
# Usage:
#   # Dry run (see what would execute)
#   snakemake -n --cores 8
#
#   # Local execution
#   snakemake --cores 8
#
#   # HPC execution with SLURM
#   snakemake --profile slurm --jobs 20
#
#   # Generate DAG visualization
#   snakemake --dag | dot -Tpdf > dag.pdf
#
# =============================================================================

import os
from pathlib import Path

# Activate conda environment for all shell commands
# MKL_INTERFACE_LAYER=ILP64 needed for TACCO with large matrices (>2B elements)
shell.prefix("module load miniforge3 && eval \"$(conda shell.bash hook)\" && conda activate /scratch/chaunzt1/stagebridge_env && export MKL_INTERFACE_LAYER=ILP64 && ")

# =============================================================================
# Configuration
# =============================================================================

configfile: "workflow/config.yaml"

# Data paths
DATA = config.get("data_root", os.environ.get("DATA", "/scratch/chaunzt1/stagebridge"))
PROCESSED = f"{DATA}/processed/luad_evo"
REFERENCES = f"{DATA}/references"
RUNS = f"{DATA}/runs"

# Output directories
REF_GEOM = f"{PROCESSED}/reference_geometry"
SPATIAL = f"{RUNS}/spatial_benchmark"
CANONICAL = f"{PROCESSED}/canonical"
TRAINING = f"{RUNS}/v1_complete"
ABLATIONS = f"{RUNS}/ablations"
FIGURES = f"{RUNS}/publication_figures"

# Spatial backends to run
SPATIAL_BACKENDS = ["tangram", "destvi", "tacco", "cell2location"]

# Cross-validation settings
FOLDS = [0, 1, 2, 3, 4]  # 5-fold CV
SEEDS = [42, 123, 456]   # 3 seeds per fold for variance estimation

# =============================================================================
# Final Targets (what we want to produce)
# =============================================================================

rule all:
    input:
        # Reference geometry
        f"{REF_GEOM}/fused_embedding.parquet",
        # Spatial benchmark
        f"{SPATIAL}/backend_comparison.json",
        # Training (5-fold CV × 3 seeds, aggregated)
        f"{TRAINING}/aggregated/cv_results.json",
        f"{TRAINING}/aggregated/publication_metrics.json",
        # Baseline ladder comparison
        f"{TRAINING}/baselines/baseline_comparison.json",
        # Ablations
        f"{ABLATIONS}/ablation_summary.json",
        # Publication figures
        f"{FIGURES}/manifests/figure_manifest.json"


# =============================================================================
# Stage 1: HLCA Reference Mapping
# =============================================================================

rule hlca_mapping:
    input:
        query = f"{PROCESSED}/snrna_qc_normalized_with_ensg.h5ad",
        ref = f"{REFERENCES}/hlca/hlca_reference.h5ad"
    output:
        latent = f"{REF_GEOM}/hlca_mapping/hlca_latent.h5ad",
        labels = f"{REF_GEOM}/hlca_mapping/hlca_labels.parquet",
        report = f"{REF_GEOM}/hlca_mapping/mapping_report.json"
    params:
        model_dir = f"{REFERENCES}/hlca/hub_cache",
        data_root = DATA,
        output_dir = REF_GEOM
    threads: 8
    resources:
        mem_mb = 256000,
        runtime = 360,  # 6 hours (scArches surgery ~2-4h)
        slurm_partition = "gpu",
        gpu = 1
    log:
        f"{RUNS}/logs/hlca_mapping.log"
    shell:
        """
        python -m stagebridge.pipelines.run_reference \
            --data-root {params.data_root} \
            --snrna {input.query} \
            --hlca {input.ref} \
            --hlca-model {params.model_dir} \
            --output-dir {params.output_dir} \
            --hlca-only \
            --hpc \
            --use-model-based \
            2>&1 | tee {log}
        """


# =============================================================================
# Stage 2: LuCA Reference Mapping (parallel with HLCA)
# =============================================================================

rule luca_mapping:
    input:
        query = f"{PROCESSED}/snrna_qc_normalized_with_ensg.h5ad",
        ref = f"{REFERENCES}/luca/luca_core_atlas.h5ad"
    params:
        model_dir = f"{REFERENCES}/luca/retrained_model/scanvi_model",
        data_root = DATA,
        output_dir = REF_GEOM
    output:
        latent = f"{REF_GEOM}/luca_mapping/luca_latent.h5ad",
        labels = f"{REF_GEOM}/luca_mapping/luca_labels.parquet",
        report = f"{REF_GEOM}/luca_mapping/mapping_report.json"
    threads: 8
    resources:
        mem_mb = 256000,
        runtime = 360,  # 6 hours (scArches surgery ~2-4h)
        slurm_partition = "gpu",
        gpu = 1
    log:
        f"{RUNS}/logs/luca_mapping.log"
    shell:
        """
        python -m stagebridge.pipelines.run_reference \
            --data-root {params.data_root} \
            --snrna {input.query} \
            --luca {input.ref} \
            --luca-model {params.model_dir} \
            --output-dir {params.output_dir} \
            --luca-only \
            --hpc \
            --use-model-based \
            2>&1 | tee {log}
        """


# =============================================================================
# Stage 2b: Fuse Embeddings (after both HLCA and LuCA)
# =============================================================================

rule fuse_embeddings:
    input:
        hlca = f"{REF_GEOM}/hlca_mapping/hlca_latent.h5ad",
        luca = f"{REF_GEOM}/luca_mapping/luca_latent.h5ad"
    output:
        fused = f"{REF_GEOM}/fused_embedding.parquet",
        confidence = f"{REF_GEOM}/reference_confidence.parquet"
    threads: 4
    resources:
        mem_mb = 64000,
        runtime = 30
    log:
        f"{RUNS}/logs/fuse_embeddings.log"
    script:
        "scripts/fuse_embeddings.py"


# =============================================================================
# Stage 2c: Merge Cell Types into snRNA (clean Snakemake dependency)
# =============================================================================

rule merge_cell_types:
    input:
        snrna = f"{PROCESSED}/snrna_qc_normalized_with_ensg.h5ad",
        labels = f"{REF_GEOM}/hlca_mapping/hlca_labels.parquet"
    output:
        snrna_with_celltypes = f"{PROCESSED}/snrna_with_celltypes.h5ad"
    threads: 4
    resources:
        mem_mb = 128000,
        runtime = 30
    log:
        f"{RUNS}/logs/merge_cell_types.log"
    shell:
        """
        python workflow/scripts/merge_cell_types.py \
            --snrna {input.snrna} \
            --labels {input.labels} \
            --output {output.snrna_with_celltypes} \
            2>&1 | tee {log}
        """


# =============================================================================
# Stage 2d: Validate Cell Type Markers (QC check before spatial deconv)
# =============================================================================

rule validate_markers:
    input:
        snrna = f"{PROCESSED}/snrna_with_celltypes.h5ad"
    output:
        report = f"{REF_GEOM}/marker_validation.json",
        enrichment = f"{REF_GEOM}/marker_validation.enrichment.csv"
    threads: 4
    resources:
        mem_mb = 64000,
        runtime = 30
    log:
        f"{RUNS}/logs/validate_markers.log"
    shell:
        """
        python workflow/scripts/validate_markers.py \
            --adata {input.snrna} \
            --cell_type_col cell_type \
            --output {output.report} \
            2>&1 | tee {log}
        """


# =============================================================================
# Stage 3: Spatial Backend Benchmark (per-sample, then aggregate)
# NOTE: Requires snRNA with cell types AND marker validation
# =============================================================================

# Step 3a: Extract sample IDs from spatial data (checkpoint for dynamic samples)
checkpoint extract_spatial_samples:
    input:
        spatial = f"{PROCESSED}/spatial_merged.h5ad"
    output:
        manifest = f"{SPATIAL}/sample_manifest.json"
    resources:
        mem_mb = 128000,  # 128GB to load spatial file
        runtime = 30
    log:
        f"{RUNS}/logs/extract_spatial_samples.log"
    shell:
        """
        python workflow/scripts/extract_spatial_samples.py \
            --spatial {input.spatial} \
            --output {output.manifest} \
            --sample-col sample_id \
            2>&1 | tee {log}
        """


# Step 3b: Run backend on single sample
rule spatial_backend_sample:
    input:
        snrna = f"{PROCESSED}/snrna_with_celltypes.h5ad",
        spatial = f"{PROCESSED}/spatial_merged.h5ad",
        marker_check = f"{REF_GEOM}/marker_validation.json",
        manifest = f"{SPATIAL}/sample_manifest.json"
    output:
        metrics = f"{SPATIAL}/{{backend}}/samples/{{sample}}/upstream_metrics.json",
        proportions = f"{SPATIAL}/{{backend}}/samples/{{sample}}/cell_type_proportions.parquet"
    wildcard_constraints:
        backend = "|".join(SPATIAL_BACKENDS)
    threads: 4
    resources:
        mem_mb = 180000,  # 180GB needed to load 51GB spatial + snRNA files
        runtime = 120,    # 2h per sample
        slurm_partition = "gpu",
        gpu = 1
    log:
        f"{RUNS}/logs/spatial_{{backend}}_{{sample}}.log"
    shell:
        """
        python -m stagebridge.pipelines.run_spatial_benchmark \
            --snrna {input.snrna} \
            --spatial {input.spatial} \
            --output_dir {SPATIAL}/{wildcards.backend}/samples/{wildcards.sample} \
            --backends {wildcards.backend} \
            --sample {wildcards.sample} \
            --sample-col sample_id \
            2>&1 | tee {log}
        """


def get_all_sample_outputs(wildcards):
    """Get all per-sample output files for a backend after checkpoint."""
    checkpoint_output = checkpoints.extract_spatial_samples.get(**wildcards).output.manifest
    import json
    with open(checkpoint_output) as f:
        manifest = json.load(f)
    samples = manifest["samples"]
    return expand(
        f"{SPATIAL}/{wildcards.backend}/samples/{{sample}}/upstream_metrics.json",
        sample=samples
    )


# Step 3c: Aggregate per-sample results into backend summary
rule spatial_backend_aggregate:
    input:
        sample_metrics = get_all_sample_outputs,
        manifest = f"{SPATIAL}/sample_manifest.json"
    output:
        metrics = f"{SPATIAL}/{{backend}}/upstream_metrics.json",
        proportions = f"{SPATIAL}/{{backend}}/cell_type_proportions.parquet"
    wildcard_constraints:
        backend = "|".join(SPATIAL_BACKENDS)
    threads: 2
    resources:
        mem_mb = 32000,
        runtime = 30
    log:
        f"{RUNS}/logs/spatial_{{backend}}_aggregate.log"
    shell:
        """
        python workflow/scripts/aggregate_spatial_samples.py \
            --backend {wildcards.backend} \
            --sample-dir {SPATIAL}/{wildcards.backend}/samples \
            --output-dir {SPATIAL}/{wildcards.backend} \
            --manifest {input.manifest} \
            2>&1 | tee {log}
        """


# Step 3d: Compare backends (unchanged, uses aggregated results)
rule spatial_comparison:
    input:
        expand(SPATIAL + "/{backend}/upstream_metrics.json", backend=SPATIAL_BACKENDS)
    output:
        comparison = f"{SPATIAL}/backend_comparison.json",
        canonical = f"{SPATIAL}/canonical_backend.json",
        figure = f"{SPATIAL}/backend_comparison.png"
    threads: 2
    resources:
        mem_mb = 16000,
        runtime = 15
    log:
        f"{RUNS}/logs/spatial_comparison.log"
    script:
        "scripts/compare_spatial_backends.py"


# =============================================================================
# Stage 4: Complete Data Preparation
# =============================================================================

rule data_preparation:
    input:
        fused = f"{REF_GEOM}/fused_embedding.parquet",
        spatial_comparison = f"{SPATIAL}/backend_comparison.json",
        snrna = f"{PROCESSED}/snrna_with_celltypes.h5ad",  # Use file with cell types
        spatial = f"{PROCESSED}/spatial_merged.h5ad",
        wes = f"{PROCESSED}/wes_features.parquet"
    output:
        cells = f"{CANONICAL}/cells.parquet",
        neighborhoods = f"{CANONICAL}/neighborhoods.parquet",
        splits = f"{CANONICAL}/split_manifest.json",
        manifest = f"{CANONICAL}/data_manifest.json"
    params:
        spatial_dir = SPATIAL,
        canonical_dir = CANONICAL
    threads: 16
    resources:
        mem_mb = 256000,
        runtime = 120,  # 2 hours
        slurm_partition = "gpu",
        gpu = 1
    log:
        f"{RUNS}/logs/data_preparation.log"
    shell:
        """
        python -m stagebridge.pipelines.complete_data_prep \
            --snrna {input.snrna} \
            --spatial {input.spatial} \
            --wes {input.wes} \
            --spatial_backend_dir {params.spatial_dir} \
            --output_dir {params.canonical_dir} \
            2>&1 | tee {log}
        """


# =============================================================================
# Stage 4b: Validate Splits (CRITICAL - prevents donor leakage)
# =============================================================================

rule validate_splits:
    input:
        cells = f"{CANONICAL}/cells.parquet",
        splits = f"{CANONICAL}/split_manifest.json"
    output:
        report = f"{CANONICAL}/leakage_validation.json"
    threads: 1
    resources:
        mem_mb = 16000,
        runtime = 10
    log:
        f"{RUNS}/logs/validate_splits.log"
    shell:
        """
        python workflow/scripts/validate_splits.py \
            --cells {input.cells} \
            --splits {input.splits} \
            --output {output.report} \
            2>&1 | tee {log}
        """


# =============================================================================
# Stage 5a: Generate Semi-Synthetic Benchmark (with ground truth)
# =============================================================================

rule semi_synthetic_benchmark:
    input:
        manifest = f"{CANONICAL}/data_manifest.json",
        leakage_check = f"{CANONICAL}/leakage_validation.json"  # Require clean splits
    output:
        benchmark = f"{CANONICAL}/benchmark/semi_synthetic.pt",
        ground_truth = f"{CANONICAL}/benchmark/ground_truth.json"
    threads: 4
    resources:
        mem_mb = 64000,
        runtime = 30
    log:
        f"{RUNS}/logs/semi_synthetic_benchmark.log"
    script:
        "scripts/generate_semi_synthetic.py"


# =============================================================================
# Stage 5b: Hyperparameter Optimization (Optuna)
# =============================================================================

rule hpo:
    input:
        cells = f"{CANONICAL}/cells.parquet",
        neighborhoods = f"{CANONICAL}/neighborhoods.parquet",
        splits = f"{CANONICAL}/split_manifest.json",
        benchmark = f"{CANONICAL}/benchmark/semi_synthetic.pt",
        leakage_check = f"{CANONICAL}/leakage_validation.json"  # Require clean splits
    output:
        best_params = f"{TRAINING}/hpo/best_params.json",
        hpo_history = f"{TRAINING}/hpo/optimization_history.json"
    params:
        n_trials = 30,
        canonical_dir = CANONICAL,
        hpo_dir = f"{TRAINING}/hpo"
    threads: 8
    resources:
        mem_mb = 128000,
        runtime = 480,  # 8 hours for 30 trials
        slurm_partition = "gpu",
        gpu = 1
    log:
        f"{RUNS}/logs/hpo.log"
    shell:
        """
        python -m stagebridge.pipelines.run_hpo \
            --data_dir {params.canonical_dir} \
            --output_dir {params.hpo_dir} \
            --n_trials {params.n_trials} \
            2>&1 | tee {log}
        """


# =============================================================================
# Stage 5c: Full Model Training (Two-Stage: SSL + Transition)
# =============================================================================
#
# 5-fold cross-validation × 3 seeds = 15 training runs
# Each run: SSL Pretraining + Transition Model
#
# Stage 1: SSL Pretraining (~4-6 hours with 4 GPUs)
#   - Objective: Masked receiver reconstruction from niche context
#   - Learn niche-aware representations
#
# Stage 2: Transition Model (~2-3 hours with 4 GPUs)
#   - Objective: Predict state transitions (flow field)
#   - Fine-tune on stage transition dynamics
#

rule training:
    input:
        cells = f"{CANONICAL}/cells.parquet",
        neighborhoods = f"{CANONICAL}/neighborhoods.parquet",
        splits = f"{CANONICAL}/split_manifest.json",
        benchmark = f"{CANONICAL}/benchmark/semi_synthetic.pt",
        hpo_params = f"{TRAINING}/hpo/best_params.json",
        leakage_check = f"{CANONICAL}/leakage_validation.json"  # Require clean splits
    output:
        checkpoint = f"{TRAINING}/fold{{fold}}_seed{{seed}}/checkpoints/final_checkpoint.pt",
        best = f"{TRAINING}/fold{{fold}}_seed{{seed}}/checkpoints/best_checkpoint.pt",
        ssl_checkpoint = f"{TRAINING}/fold{{fold}}_seed{{seed}}/checkpoints/ssl_pretrained.pt",
        metrics = f"{TRAINING}/fold{{fold}}_seed{{seed}}/metrics/training_metrics.csv",
        config = f"{TRAINING}/fold{{fold}}_seed{{seed}}/config.json",
        results = f"{TRAINING}/fold{{fold}}_seed{{seed}}/results.json"
    wildcard_constraints:
        fold = "[0-4]",
        seed = "[0-9]+"
    params:
        n_gpus = 4,
        ssl_epochs = 100,
        transition_epochs = 50,
        canonical_dir = CANONICAL,
        training_dir = TRAINING
    threads: 32  # 8 per GPU for data loading
    resources:
        mem_mb = 512000,
        runtime = 720,  # 12 hours (SSL ~6h + transition ~3h + buffer)
        slurm_partition = "gpu",
        gpu = 4,
        slurm_extra = "'--constraint=h100'"
    log:
        f"{RUNS}/logs/training_fold{{fold}}_seed{{seed}}.log"
    shell:
        """
        echo "=============================================="
        echo "StageBridge V1 Training"
        echo "  Fold: {wildcards.fold}/5"
        echo "  Seed: {wildcards.seed}"
        echo "  Stage 1: SSL Pretraining ({params.ssl_epochs} epochs)"
        echo "  Stage 2: Transition Model ({params.transition_epochs} epochs)"
        echo "  GPUs: {params.n_gpus}"
        echo "  HPO params: {input.hpo_params}"
        echo "=============================================="

        torchrun \
            --nproc_per_node={params.n_gpus} \
            --master_port=$((29500 + {wildcards.fold} * 10 + {wildcards.seed} % 10)) \
            -m stagebridge.pipelines.run_v1_ddp \
            --data_dir {params.canonical_dir} \
            --output_dir {params.training_dir}/fold{wildcards.fold}_seed{wildcards.seed} \
            --validation_fold {wildcards.fold} \
            --seed {wildcards.seed} \
            --ssl_epochs {params.ssl_epochs} \
            --transition_epochs {params.transition_epochs} \
            --batch_size 256 \
            --checkpoint_every 10 \
            --hpo_params {input.hpo_params} \
            --use_best_hparams \
            2>&1 | tee {log}
        """


# =============================================================================
# Stage 5d: Aggregate CV Results (with Bootstrap CIs)
# =============================================================================

rule aggregate_cv_results:
    input:
        results = expand(
            f"{TRAINING}/fold{{fold}}_seed{{seed}}/results.json",
            fold=FOLDS, seed=SEEDS
        )
    output:
        cv_results = f"{TRAINING}/aggregated/cv_results.json",
        publication_metrics = f"{TRAINING}/aggregated/publication_metrics.json",
        latex_table = f"{TRAINING}/aggregated/table_main_results.tex"
    threads: 2
    resources:
        mem_mb = 16000,
        runtime = 15
    log:
        f"{RUNS}/logs/aggregate_cv_results.log"
    shell:
        """
        python workflow/scripts/aggregate_cv_results.py \
            --input_dir {TRAINING} \
            --output_dir {TRAINING}/aggregated \
            --n_folds 5 \
            --seeds 42 123 456 \
            --n_bootstrap 1000 \
            2>&1 | tee {log}
        """


# =============================================================================
# Stage 5e: Baseline Ladder (fair comparison with same splits/seeds)
# =============================================================================
#
# Tests core novelty: "Cross-sectional progression becomes more identifiable
# when conditioned on receiver-centered local niche context"
#
# Baselines (increasing complexity):
# 1. pooling_mlp - No structure (bag-of-cells)
# 2. deep_sets - Permutation invariance only
# 3. set_transformer - Flat attention (no spatial structure)
# 4. graph_sage - Spatial graph structure
# 5. stagebridge - Full model (receiver-centered niche + dual references)
#

BASELINES = ["pooling_mlp", "deep_sets", "set_transformer", "graph_sage"]

rule baseline:
    input:
        cells = f"{CANONICAL}/cells.parquet",
        neighborhoods = f"{CANONICAL}/neighborhoods.parquet",
        splits = f"{CANONICAL}/split_manifest.json",
        benchmark = f"{CANONICAL}/benchmark/semi_synthetic.pt",
        leakage_check = f"{CANONICAL}/leakage_validation.json"
    output:
        results = f"{TRAINING}/baselines/{{baseline}}/fold{{fold}}_seed{{seed}}/results.json",
        metrics = f"{TRAINING}/baselines/{{baseline}}/fold{{fold}}_seed{{seed}}/metrics.csv"
    wildcard_constraints:
        baseline = "|".join(BASELINES),
        fold = "[0-4]",
        seed = "[0-9]+"
    params:
        canonical_dir = CANONICAL
    threads: 8
    resources:
        mem_mb = 128000,
        runtime = 180,  # 3 hours (baselines train faster)
        slurm_partition = "gpu",
        gpu = 1
    log:
        f"{RUNS}/logs/baseline_{{baseline}}_fold{{fold}}_seed{{seed}}.log"
    shell:
        """
        python -m stagebridge.baselines.evaluate \
            --data_dir {params.canonical_dir} \
            --output_dir {TRAINING}/baselines/{wildcards.baseline}/fold{wildcards.fold}_seed{wildcards.seed} \
            --baseline {wildcards.baseline} \
            --validation_fold {wildcards.fold} \
            --seed {wildcards.seed} \
            2>&1 | tee {log}
        """


rule aggregate_baselines:
    input:
        # All baseline results (4 baselines × 5 folds × 3 seeds = 60 runs)
        baseline_results = expand(
            f"{TRAINING}/baselines/{{baseline}}/fold{{fold}}_seed{{seed}}/results.json",
            baseline=BASELINES, fold=FOLDS, seed=SEEDS
        ),
        # Main model results for comparison
        main_results = f"{TRAINING}/aggregated/cv_results.json"
    output:
        comparison = f"{TRAINING}/baselines/baseline_comparison.json",
        latex_table = f"{TRAINING}/baselines/table_baseline_ladder.tex"
    threads: 2
    resources:
        mem_mb = 16000,
        runtime = 15
    log:
        f"{RUNS}/logs/aggregate_baselines.log"
    shell:
        """
        python workflow/scripts/aggregate_baselines.py \
            --baseline_dir {TRAINING}/baselines \
            --main_results {input.main_results} \
            --output_dir {TRAINING}/baselines \
            --baselines pooling_mlp deep_sets set_transformer graph_sage \
            --n_folds 5 \
            --seeds 42 123 456 \
            2>&1 | tee {log}
        """


# =============================================================================
# Stage 6: Ablation Studies
# =============================================================================

ABLATIONS_LIST = [
    "no_niche", "pooled_niche", "no_hierarchy", "no_hlca", "no_luca",
    "single_reference", "no_attention", "no_flow", "deterministic",
    "no_genomics", "no_uncertainty", "reduced_latent", "no_ssl", "baseline_mlp"
]

rule ablation:
    input:
        canonical = f"{CANONICAL}/data_manifest.json",
        # Use fold 0, seed 42 as representative for ablations (consistent baseline)
        full_model = f"{TRAINING}/fold0_seed42/checkpoints/final_checkpoint.pt"
    output:
        results = f"{ABLATIONS}/{{ablation}}/results.json",
        metrics = f"{ABLATIONS}/{{ablation}}/metrics.csv"
    wildcard_constraints:
        ablation = "|".join(ABLATIONS_LIST)
    params:
        canonical_dir = CANONICAL,
        ablations_dir = ABLATIONS
    threads: 8
    resources:
        mem_mb = 128000,
        runtime = 360,  # 6 hours per ablation
        slurm_partition = "gpu",
        gpu = 1
    log:
        f"{RUNS}/logs/ablation_{{ablation}}.log"
    shell:
        """
        python -m stagebridge.pipelines.run_ablations \
            --data_dir {params.canonical_dir} \
            --output_dir {params.ablations_dir}/{wildcards.ablation} \
            --ablations {wildcards.ablation} \
            2>&1 | tee {log}
        """


rule ablation_summary:
    input:
        expand(ABLATIONS + "/{ablation}/results.json", ablation=ABLATIONS_LIST)
    output:
        summary = f"{ABLATIONS}/ablation_summary.json",
        table = f"{ABLATIONS}/table3_main_results.csv",
        latex = f"{ABLATIONS}/table3_main_results.tex"
    threads: 2
    resources:
        mem_mb = 8000,
        runtime = 15
    log:
        f"{RUNS}/logs/ablation_summary.log"
    script:
        "scripts/summarize_ablations.py"


# =============================================================================
# Stage 7: Publication Figures
# =============================================================================

rule publication_figures:
    input:
        fused = f"{REF_GEOM}/fused_embedding.parquet",
        spatial = f"{SPATIAL}/backend_comparison.json",
        training = f"{TRAINING}/aggregated/publication_metrics.json",
        ablations = f"{ABLATIONS}/ablation_summary.json"
    output:
        manifest = f"{FIGURES}/manifests/figure_manifest.json",
        main_figs = directory(f"{FIGURES}/main"),
        supp_figs = directory(f"{FIGURES}/supplementary")
    threads: 8
    resources:
        mem_mb = 64000,
        runtime = 120,  # 2 hours
        slurm_partition = "gpu",
        gpu = 1
    log:
        f"{RUNS}/logs/figures.log"
    script:
        "scripts/generate_publication_figures.py"


# =============================================================================
# Utility Rules
# =============================================================================

rule clean:
    params:
        runs_dir = RUNS,
        ref_geom_dir = REF_GEOM,
        canonical_dir = CANONICAL
    shell:
        """
        echo "This would remove all outputs. Use with caution!"
        echo "Run: rm -rf {params.runs_dir}/* {params.ref_geom_dir}/* {params.canonical_dir}/*"
        """


rule dag:
    output:
        "workflow/dag.pdf"
    shell:
        "snakemake --dag | dot -Tpdf > {output}"


