rule summary:
    """Generate results summary from whatever exists now.

    Run anytime to see current progress:
        snakemake summary --profile workflow/slurm

    This is a "checkpoint" target - it doesn't wait for other rules,
    it just summarizes whatever results have completed so far.
    """
    output:
        json=f"{RESULTS_DIR}/results_summary_live.json",
        csv=f"{RESULTS_DIR}/results_summary_live.csv",
        md=f"{RESULTS_DIR}/results_summary_live.md",
    params:
        results_dir=OUTPUT_DIR,
        data_dir=DATA_DIR,
    resources:
        mem_mb=16000,
        runtime=10,
        slurm_partition="cpu",
    shell:
        """
        python -m stagebridge.evaluation.results_summary \
            --results-dir {params.results_dir} \
            --data-dir {params.data_dir} \
            --output-dir {RESULTS_DIR}

        # Rename to live (indicates this is a snapshot, not final)
        mv {RESULTS_DIR}/results_summary.json {output.json} 2>/dev/null || true
        mv {RESULTS_DIR}/results_summary.csv {output.csv} 2>/dev/null || true
        mv {RESULTS_DIR}/results_summary.md {output.md} 2>/dev/null || true

        # Print summary to stdout for quick viewing
        cat {output.md}
        """


rule clean:
    """Remove all outputs."""
    shell:
        "rm -rf {OUTPUT_DIR}"


rule clean_figures:
    """Remove only figures, keep training artifacts."""
    shell:
        "rm -rf {FIGURES_DIR}"


rule dry_run:
    """Show what would be executed."""
    shell:
        "snakemake -n --quiet"
