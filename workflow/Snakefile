    shell:
        "rm -rf {OUTPUT_DIR}"


rule clean_figures:
    """Remove only figures, keep training artifacts."""
    shell:
        "rm -rf {FIGURES_DIR}"


rule dry_run:
    """Show what would be executed."""
    shell:
        "snakemake -n --quiet"
