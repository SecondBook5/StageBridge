            --input_dir {TRAINING} \
            --output_dir {TRAINING}/aggregated \
            --n_folds 5 \
            --seeds 42 123 456 \
            --n_bootstrap 1000 \
            2>&1 | tee {log}
        """


# =============================================================================
# Stage 5d-bis: H3 Hypothesis Validation (clonal evolution patterns)
