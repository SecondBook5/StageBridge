rule results_summary:
    """Generate comprehensive results summary - the one-stop-shop for all outputs.

    Produces:
    - results_summary.json: Complete machine-readable summary
    - results_summary.csv: Flat table of key metrics
    - results_summary.md: Human-readable markdown report

    This rule aggregates whatever results exist at the time it runs.
    It's designed to be called multiple times as results come in.
    """
    input:
        # Depends on comparison_report which aggregates everything
        report=f"{RESULTS_DIR}/comparison_report.json",
    output:
        json=f"{RESULTS_DIR}/results_summary.json",
        csv=f"{RESULTS_DIR}/results_summary.csv",
        md=f"{RESULTS_DIR}/results_summary.md",
    params:
        results_dir=OUTPUT_DIR,
        data_dir=DATA_DIR,
    resources:
        mem_mb=32000,
        runtime=15,
        slurm_partition="cpu",
    shell:
        """
        python -m stagebridge.evaluation.results_summary \
            --results-dir {params.results_dir} \
            --data-dir {params.data_dir} \
            --output-dir {RESULTS_DIR}
        """


