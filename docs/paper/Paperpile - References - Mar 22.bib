@ARTICLE{Cable2022-tb,
  title     = "Robust decomposition of cell type mixtures in spatial
               transcriptomics",
  author    = "Cable, Dylan M and Murray, Evan and Zou, Luli S and Goeva,
               Aleksandrina and Macosko, Evan Z and Chen, Fei and Irizarry,
