@ARTICLE{Tejada-Lapuerta2025-wz,
  title     = "Nicheformer: a foundation model for single-cell and spatial omics",
  author    = "Tejada-Lapuerta, Alejandro and Schaar, Anna C and Gutgesell,
               Robert and Palla, Giovanni and Halle, Lennard and Minaeva, Mariia
