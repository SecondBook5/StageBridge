@ARTICLE{Mason2023-kd,
  title    = "Niche differential gene expression analysis in spatial
              transcriptomics data identifies context-dependent cell-cell
              interactions",
  author   = "Mason, Kaishu and Sathe, Anuja and Hess, Paul and Rong, Jiazhen
