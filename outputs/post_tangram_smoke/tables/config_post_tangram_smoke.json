{
  "model": {
    "_target_": "stagebridge.models.stagebridge.StageBridgeModel",
    "config": {
      "_target_": "stagebridge.models.stagebridge.StageBridgeConfig",
      "input_dim": 64,
      "hidden_dim": 128,
      "vector_field_hidden_dim": 256,
      "num_heads": 8,
      "num_inducing_points": 16,
      "num_seed_vectors": 1,
      "num_stages": 5,
      "time_embedding_dim": 32,
      "stage_embedding_dim": 32,
      "dropout": 0.1
    }
  },
  "training": {
    "max_epochs": 1,
    "steps_per_epoch": 10,
    "val_steps": 1,
    "batch_cells": 128,
    "num_ot_pairs": 128,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "grad_clip_norm": 1.0,
    "gradient_accumulation_steps": 1,
    "patience": 20,
    "mixed_precision": false,
    "ot_epsilon": 0.05,
    "sinkhorn_iters": 80,
    "context_consistency_weight": 0.1,
    "use_ot": true,
    "use_stage_embedding": true,
    "seed": 42,
    "device": "cpu",
    "transition_src": "AIS",
    "transition_tgt": "MIA",
    "use_niche_tokens": true,
    "niche_token_bank_path": "/mnt/e/StageBridge_data/processed/features/niche_token_bank.zarr",
    "m_niche": 64,
    "niche_sampling_strategy": "random_m",
    "niche_fallback": "donor",
    "niche_random_seed": 42
  },
  "data": {
    "data_root": "/mnt/e/StageBridge_data",
    "raw": {
      "geo_snrna_dir": "/mnt/e/StageBridge_data/raw/geo/GSE308103_snrna",
      "geo_spatial_dir": "/mnt/e/StageBridge_data/raw/geo/GSE307534_spatial",
      "hlca_dir": "/mnt/e/StageBridge_data/raw/hlca"
    },
    "interim": {
      "anndata_snrna_dir": "/mnt/e/StageBridge_data/interim/anndata/snrna",
      "anndata_spatial_dir": "/mnt/e/StageBridge_data/interim/anndata/spatial"
    },
    "processed": {
      "anndata_dir": "/mnt/e/StageBridge_data/processed/anndata",
      "hlca_dir": "/mnt/e/StageBridge_data/processed/hlca",
      "tangram_dir": "/mnt/e/StageBridge_data/processed/tangram",
      "mapping_dir": "/mnt/e/StageBridge_data/processed/mapping",
      "figures_dir": "/mnt/e/StageBridge_data/processed/figures",
      "features_dir": "/mnt/e/StageBridge_data/processed/features"
    },
    "runs_dir": "/mnt/e/StageBridge_data/runs",
    "input_snrna_full_h5ad": "/mnt/e/StageBridge_data/interim/anndata/snrna/snrna_full.h5ad",
    "input_spatial_full_h5ad": "/mnt/e/StageBridge_data/interim/anndata/spatial/spatial_full.h5ad",
    "output_processed_anndata_dir": "/mnt/e/StageBridge_data/processed/anndata",
    "output_processed_hlca_dir": "/mnt/e/StageBridge_data/processed/hlca",
    "output_processed_tangram_dir": "/mnt/e/StageBridge_data/processed/tangram",
    "snrna_h5ad": "/mnt/e/StageBridge_data/processed/anndata/snrna_hlca_latent_full.h5ad",
    "spatial_h5ad": "/mnt/e/StageBridge_data/interim/anndata/spatial/spatial_full.h5ad",
    "hlca_h5ad": "/mnt/e/StageBridge_data/data/reference/hlca/hlca_full_v1.h5ad",
    "latent_key": "X_hlca",
    "fallback_latent_key": "X_pca",
    "stage_col": "stage",
    "donor_col": "patient_id",
    "sample_col": "sample_id",
    "use_spatial": false,
    "use_hlca_reference": true,
    "max_cells": 50000
  },
  "splits": {
    "name": "donor_holdout",
    "n_folds": 2,
    "min_stages_per_donor": 2,
    "stage_coverage_required": true
